---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import PricingCard from '../components/PricingCard.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import { 
  Trophy, 
  Check, 
  ArrowRight, 
  ShieldCheck, 
  Sparkles
} from 'lucide-astro';

const comparisonsList = [
  {
    name: "AcheterIPTVPro",
    slug: "abonnement-iptv-vs-acheteriptvpro",
    summary: "Concurrent historique sur le marché français mais grevé par des prix élevés (75€+) et une absence de lecteur offert.",
    rating: "3.8/5",
    ourAdvantage: "Prix 55 €/an + Lecteur Inclus + Anti-Freeze 9.8™"
  },
  {
    name: "Abonnements IPTV Premium",
    slug: "abonnement-iptv-vs-abonnementsiptv-premium",
    summary: "Offre standard pénalisée par des coupures régulières lors des soirées de Ligue 1 et un support lent.",
    rating: "3.6/5",
    ourAdvantage: "Stabilité 99.98% garantie + Support WhatsApp < 3 min"
  },
  {
    name: "IPTV Premium France",
    slug: "abonnement-iptv-vs-iptv-premiumfrance",
    summary: "Service très présent sur les réseaux sociaux mais marqué par une redondance de serveurs insuffisante.",
    rating: "3.7/5",
    ourAdvantage: "Serveurs redondants 10 Gbps + Chiffrement SSL 256 bits"
  },
  {
    name: "Bouquets TV Traditionnels & Câble",
    slug: "abonnement-iptv-vs-cable-traditionnel",
    summary: "Facture cumulée de plus de 1 000 €/an avec des applications éclatées et des contrats avec engagement forcé.",
    rating: "2.9/5",
    ourAdvantage: "Économisez plus de 940 €/an sans aucun engagement"
  }
];

const checklist = [
  {
    title: "Technologie Anti-Coupure (Anti-Freeze)",
    desc: "Un vrai système anti-freeze compense les micro-variations de bande passante et évite le gel d'écran sur les actions décisives."
  },
  {
    title: "Diffusion 4K Réelle à 60 FPS",
    desc: "Pour les sports rapides (football, Formule 1, tennis), le 60 FPS est indispensable pour éliminer le flou de mouvement."
  },
  {
    title: "Support Client WhatsApp en Français",
    desc: "Privilégiez toujours un service joignable 7j/7 en direct avec des techniciens réactifs plutôt qu'un système de tickets anonyme."
  },
  {
    title: "Application de Lecture Offerte",
    desc: "Une application pré-configurée vous évite de payer des licences logicielles supplémentaires (15 à 20 €) sur votre Smart TV."
  }
];

const currentYear = new Date().getFullYear();

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `Meilleur IPTV ${currentYear} — Comparatif des 5 Meilleurs Services en France`,
  "description": `Comparatif indépendant et classement ${currentYear} des meilleurs services d'abonnement IPTV en France. Stabilité, prix, serveurs et qualité d'image.`,
  "url": "https://abonnement-iptv.cloud/meilleur-iptv"
};
---

<Layout
  title={`Meilleur IPTV ${currentYear} — Comparatif des Meilleurs Abonnements IPTV en France`}
  description={`Quel est le meilleur abonnement IPTV en France en ${currentYear} ? Comparatif des offres, prix, stabilité anti-freeze et avis vérifiés. Guide d'achat complet.`}
  canonicalURL="https://abonnement-iptv.cloud/meilleur-iptv"
  schema={pageSchema}
>
  <StickyHeader />

  <main id="main-content">
    
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-[#07080E] overflow-hidden border-b border-white/[0.06]">
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[#0055D4]/15 rounded-full blur-[140px]"></div>
      </div>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-6">
          <Trophy class="w-3.5 h-3.5 text-amber-400" />
          <span>Baromètre des Services IPTV France {currentYear}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
          Meilleur Abonnement IPTV {currentYear} : <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">Le Grand Comparatif Indépendant</span>
        </h1>

        <p class="text-base sm:text-lg text-gray-300 font-normal max-w-3xl mx-auto leading-relaxed mb-8">
          Face à la multiplication des offres et à la hausse vertigineuse des prix des bouquets de streaming traditionnels payants, notre équipe a testé et comparé les principaux acteurs IPTV pour vous orienter vers la solution la plus fiable et économique.
        </p>

        <!-- Quick Winner Banner -->
        <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-bold shadow-lg">
          <Sparkles class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Vainqueur du test {currentYear} : Abonnement IPTV France (Note 4.94 / 5 — Prix 55 €/an tout compris)</span>
        </div>

      </div>

      <!-- Comparative Infographic Visual -->
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <div class="rounded-3xl overflow-hidden border border-amber-500/30 shadow-2xl relative group">
          <img 
            src="/images/comparatif-iptv-france.webp" 
            alt="Tableau comparatif indépendant et classement des meilleurs abonnements IPTV en France" 
            class="w-full h-auto max-h-[440px] object-cover transition-transform duration-700 group-hover:scale-[1.01]"
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Detailed Comparison Links Grid -->
    <section class="py-16 md:py-24 bg-[#0A0B14]" aria-labelledby="matrix-title">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <h2 id="matrix-title" class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight mb-3">
            Face-à-Face : Comparez Notre Service aux Autres Offres
          </h2>
          <p class="text-sm sm:text-base text-gray-300 font-normal max-w-2xl mx-auto">
            Consultez nos comparatifs point par point pour comprendre nos avantages techniques et tarifaires.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {comparisonsList.map((comp) => (
            <div class="rounded-2xl bg-[#111322] border border-white/[0.08] hover:border-[#0055D4]/40 p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 shadow-xl">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Face à Face</span>
                  <span class="text-xs font-black px-2.5 py-1 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20">
                    Avis : {comp.rating}
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-black text-white mb-3">
                  Abonnement IPTV <span class="text-[#60A5FA]">vs</span> {comp.name}
                </h3>

                <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal mb-5">
                  {comp.summary}
                </p>

                <div class="p-3.5 rounded-xl bg-[#0055D4]/10 border border-[#0055D4]/20 mb-6">
                  <div class="text-[11px] font-bold text-[#60A5FA] uppercase tracking-wider mb-1">Notre Différence Majeure</div>
                  <div class="text-xs font-semibold text-white flex items-center gap-1.5">
                    <Check class="w-4 h-4 text-emerald-400 shrink-0" />
                    <span>{comp.ourAdvantage}</span>
                  </div>
                </div>
              </div>

              <a
                href={`/compare/${comp.slug}`}
                class="inline-flex items-center justify-between px-5 py-3.5 rounded-xl bg-[#17192C] hover:bg-[#0055D4] text-white font-bold text-xs transition-colors group"
              >
                <span>Lire le comparatif complet</span>
                <ArrowRight class="w-4 h-4 text-[#60A5FA] group-hover:text-white transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Buyer Guide Checklist -->
    <section class="py-16 md:py-24 bg-[#07080E] border-t border-white/[0.06]" aria-labelledby="checklist-title">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-4">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
            <span>Guide d'Achat Expert</span>
          </div>
          <h2 id="checklist-title" class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight mb-4">
            Les 4 Critères Clés pour Choisir un IPTV en France
          </h2>
          <p class="text-sm sm:text-base text-gray-300 font-normal">
            Ne vous laissez pas tromper par les faux avis. Voici ce qui garantit une expérience de streaming digne de ce nom.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {checklist.map((item, idx) => (
            <div class="rounded-2xl bg-[#101220] border border-white/[0.08] p-6 hover:border-white/20 transition-colors">
              <div class="w-8 h-8 rounded-lg bg-[#0055D4]/20 border border-[#0055D4]/40 flex items-center justify-center text-[#60A5FA] font-black text-sm mb-4">
                0{idx + 1}
              </div>
              <h3 class="text-base font-bold text-white mb-2">{item.title}</h3>
              <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Pricing Section -->
    <PricingCard />

    <!-- Bottom CTA -->
    <CTASection />

  </main>

  <Footer />

  <FloatingWhatsApp />
  <SocialPopup />
  <ExitPopup />
  <GroupsPopup />

</Layout>
