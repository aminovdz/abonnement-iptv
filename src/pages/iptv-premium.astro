---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import LiveScores from '../components/LiveScores.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import { 
  CheckCircle2, 
  Star, 
  ShieldCheck, 
  Zap, 
  Tv, 
  Clock, 
  ArrowRight,
  MessageCircle, 
  BadgePercent,
  HelpCircle,
  Award,
  Sparkles,
  Server,
  Film,
  MonitorPlay,
  Check,
  X,
  Lock,
  Smartphone
} from 'lucide-astro';

const currentYear = new Date().getFullYear();

// Server-Side Schema.org (Product + AggregateRating + FAQPage + BreadcrumbList)
const productPremiumSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": `IPTV Premium France ${currentYear} — Streaming 4K/8K & Serveurs Dédiés 10 Gbps`,
      "image": "https://abonnement-iptv.cloud/images/iptv-premium-hero.webp",
      "description": "Découvrez le meilleur abonnement IPTV Premium en France : infrastructure serveur dédiée 10 Gbps, streaming 4K Ultra HD à 60 FPS, technologie Anti-Freeze 9.8™, Replay 7 jours et lecteur offert.",
      "brand": {
        "@type": "Brand",
        "name": "France IPTV"
      },
      "sku": `IPTV-PREMIUM-${currentYear}`,
      "mpn": "IPTV-FR-PREM-55",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "bestRating": "5.0",
        "worstRating": "1.0",
        "ratingCount": "2150",
        "reviewCount": "2150"
      },
      "offers": {
        "@type": "Offer",
        "url": "https://abonnement-iptv.cloud/iptv-premium",
        "priceCurrency": "EUR",
        "price": "55.00",
        "priceValidUntil": `${currentYear}-12-31`,
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "Abonnement IPTV France"
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "FR",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 1,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        }
      },
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "Julien D." },
          "datePublished": "2026-02-18",
          "reviewRating": { "@type": "Rating", "ratingValue": "5" },
          "reviewBody": "Le vrai niveau IPTV Premium. Enfin un service qui ne coupe pas pendant les chocs de Ligue 1 ! Le 60 FPS est bluffant sur ma TV 4K."
        },
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "Marc B." },
          "datePublished": "2026-02-05",
          "reviewRating": { "@type": "Rating", "ratingValue": "5" },
          "reviewBody": "Image d'une netteté incroyable en 4K réelle et son multicanal parfait. Zapping instantané et support WhatsApp très réactif."
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": "https://abonnement-iptv.cloud/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "IPTV Premium",
          "item": "https://abonnement-iptv.cloud/iptv-premium"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qui caractérise un véritable abonnement IPTV Premium ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un abonnement IPTV Premium se distingue par une architecture serveur dédiée 10 Gbps hébergée en Europe, un débit vidéo élevé non compressé (bitrate jusqu'à 25 Mbps), une fréquence native à 60 FPS pour les retransmissions sportives, et un protocole Anti-Freeze intelligent garantissant zéro mise en mémoire tampon."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle connexion internet est requise pour profiter de l'IPTV Premium en 4K ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une connexion fibre optique, VDSL ou 4G/5G stable d'au moins 25 à 30 Mb/s est recommandée pour apprécier pleinement le flux 4K Ultra HD à 60 FPS sans aucune latence. Pour les flux Full HD, une vitesse de 10 Mb/s est suffisante."
          }
        },
        {
          "@type": "Question",
          "name": "Le service subit-il des ralentissements pendant les grands matchs de football ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. Contrairement aux services bas de gamme qui partagent un même serveur surchargé, notre infrastructure IPTV Premium déploie un réseau CDN à répartition de charge dynamique avec bascule automatique instantanée en cas de pic de trafic lors des affiches de Ligue 1 ou de coupe d'Europe."
          }
        },
        {
          "@type": "Question",
          "name": "Quels équipements sont compatibles avec l'offre IPTV Premium ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'offre est universellement compatible : Smart TV connectées récentes, boîtiers TV de salon, clés multimédias 4K, ordinateurs (PC Windows et Mac), smartphones et tablettes (Android & iOS). Vous recevez un lien M3U chiffré et des accès Xtream Codes."
          }
        },
        {
          "@type": "Question",
          "name": "L'application ou lecteur IPTV est-il inclus dans la formule ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui ! Pour toute souscription à la formule annuelle 12 mois à 55 €, la licence d'activation du Lecteur Premium vous est offerte sans aucun supplément (valeur habituelle 15 €), incluant l'EPG interactif et le contrôle du direct."
          }
        },
        {
          "@type": "Question",
          "name": "Comment fonctionne la garantie satisfait ou remboursé 24h ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vous disposez de 24 heures complètes après l'activation pour tester l'ensemble des chaînes et de la VOD. Si vous n'êtes pas totalement convaincu de la qualité ou de la fluidité, un simple message sur notre support WhatsApp suffit pour obtenir un remboursement intégral immédiat."
          }
        }
      ]
    }
  ]
};

const comparisonPoints = [
  {
    feature: "Bande Passante & Serveurs",
    standard: "Serveurs partagés saturés (1 Gbps partagé entre des milliers d'utilisateurs)",
    premium: "Clusters CDN dédiés 10 Gbps à haute tolérance de panne",
    isWin: true
  },
  {
    feature: "Stabilité Grands Événements",
    standard: "Gels d'image fréquents et coupures lors des chocs de football en soirée",
    premium: "Technologie Anti-Freeze 9.8™ avec redondance automatique de flux",
    isWin: true
  },
  {
    feature: "Qualité Vidéo Réelle",
    standard: "Flux 1080p compressé à 25/30 FPS (flou de mouvement prononcé)",
    premium: "Véritable 4K UHD & 60 FPS natif avec bitrate élevé (jusqu'à 25 Mb/s)",
    isWin: true
  },
  {
    feature: "Zapping & Latence",
    standard: "Délai de chargement de 5 à 10 secondes entre les chaînes",
    premium: "Zapping instantané en moins d'une seconde",
    isWin: true
  },
  {
    feature: "Catalogue VOD Cinéma & Séries",
    standard: "Vidéos compressées avec sous-titres décalés et mises à jour rares",
    premium: "85 000+ films et séries 4K HDR avec son Dolby et pistes françaises",
    isWin: true
  },
  {
    feature: "Lecteur d'Application Offert",
    standard: "Application non incluse (licence payante obligatoire à vos frais)",
    premium: "Licence Lecteur Premium offerte avec la formule 12 mois (valeur 15 €)",
    isWin: true
  },
  {
    feature: "Support & Assistance",
    standard: "Support inexistant ou réponses robotisées par email sous 48h",
    premium: "Support client dédié en français sur WhatsApp disponible 7j/7 en < 3 min",
    isWin: true
  },
  {
    feature: "Garantie Remboursement",
    standard: "Aucun recours en cas d'insatisfaction ou d'interruption",
    premium: "Garantie intégrale satisfait ou remboursé sous 24 heures sans condition",
    isWin: true
  }
];

const technicalSpecs = [
  {
    icon: Server,
    title: "Réseau Dédié 10 Gbps",
    desc: "Infrastructure européenne avec bande passante garantie. Zéro saturation aux heures de pointe.",
    badge: "10 Gbps Fibre"
  },
  {
    icon: Tv,
    title: "Flux Natif 60 Images/Sec",
    desc: "Une fluidité totale sur les retransmissions sportives. Élimination complète des saccades.",
    badge: "Natif 60 FPS"
  },
  {
    icon: Zap,
    title: "Anti-Freeze 9.8™",
    desc: "Algorithme propriétaire de pré-mise en mémoire tampon et bascule transparente de flux.",
    badge: "99.98% Uptime"
  },
  {
    icon: Film,
    title: "VOD 4K HDR & Dolby",
    desc: "Plus de 85 000 titres cinéma et séries récentes avec qualité studio et son multicanal.",
    badge: "4K HDR"
  },
  {
    icon: Clock,
    title: "Replay 7 Jours & EPG",
    desc: "Guide électronique des programmes à jour et possibilité de revoir vos émissions à la demande.",
    badge: "Replay 7J"
  },
  {
    icon: ShieldCheck,
    title: "Sécurité & Chiffrement SSL",
    desc: "Liaisons protégées par chiffrement 256 bits garantissant une confidentialité totale.",
    badge: "SSL 256-bit"
  }
];

const plans = [
  {
    name: "12 Mois Premium",
    badge: "Meilleure Vente · Recommandé",
    popular: true,
    price: "55",
    period: "par an",
    equivalent: "soit ~4,58 € / mois",
    save: "Économisez 41 €",
    features: [
      "Qualité 4K UHD & 8K à 60 FPS",
      "Technologie Anti-Freeze 9.8™ active",
      "Serveurs Dédiés Fibre 10 Gbps",
      "Lecteur Premium Offert (Valeur 15 €)",
      "Toutes les chaînes direct & sport",
      "Catalogue VOD 85 000+ films & séries",
      "Replay 7 jours & Guide EPG",
      "Support VIP WhatsApp 7j/7",
      "Garantie Remboursement 24h"
    ],
    whatsappMsg: "Bonjour ! Je souhaite commander la formule IPTV Premium 12 Mois à 55 € avec le Lecteur Premium offert."
  },
  {
    name: "6 Mois Premium",
    badge: "Semestriel",
    popular: false,
    price: "30",
    period: "pour 6 mois",
    equivalent: "soit 5,00 € / mois",
    save: "Économisez 18 €",
    features: [
      "Qualité 4K UHD & 60 FPS",
      "Technologie Anti-Freeze 9.8™",
      "Bande passante prioritaire",
      "Toutes les chaînes direct & sport",
      "Catalogue VOD films & séries",
      "Replay 7 jours & Guide EPG",
      "Support WhatsApp 7j/7",
      "Garantie Remboursement 24h"
    ],
    whatsappMsg: "Bonjour ! Je souhaite commander la formule IPTV Premium 6 Mois à 30 €."
  },
  {
    name: "3 Mois Premium",
    badge: "Trimestriel",
    popular: false,
    price: "20",
    period: "pour 3 mois",
    equivalent: "soit 6,66 € / mois",
    save: "Formule flexibilité",
    features: [
      "Qualité 4K UHD & 60 FPS",
      "Technologie Anti-Freeze 9.8™",
      "Toutes les chaînes direct & sport",
      "Catalogue VOD films & séries",
      "Replay 7 jours & EPG",
      "Support WhatsApp 7j/7",
      "Garantie Remboursement 24h"
    ],
    whatsappMsg: "Bonjour ! Je souhaite commander la formule IPTV Premium 3 Mois à 20 €."
  },
  {
    name: "1 Mois Découverte",
    badge: "Essai",
    popular: false,
    price: "8",
    period: "pour 1 mois",
    equivalent: "Sans engagement",
    save: "Accès immédiat",
    features: [
      "Qualité 4K UHD & 60 FPS",
      "Technologie Anti-Freeze 9.8™",
      "Toutes les chaînes direct & sport",
      "Catalogue VOD films & séries",
      "Support WhatsApp 7j/7",
      "Garantie Remboursement 24h"
    ],
    whatsappMsg: "Bonjour ! Je souhaite tester la formule IPTV Premium 1 Mois à 8 €."
  }
];

const whatsappOrderUrl = "https://wa.me/18036582620?text=Bonjour%20!%20Je%20souhaite%20souscrire%20%C3%A0%20votre%20offre%20IPTV%20Premium%2012%20Mois%20%C3%A0%2055%20%E2%82%AC%20avec%20le%20Lecteur%20inclus.";
const whatsappTestUrl = "https://wa.me/18036582620?text=Bonjour%20!%20Je%20souhaite%20b%C3%A9n%C3%A9ficier%20d%27un%20test%20IPTV%20Premium%20pendant%2024h.";
---

<Layout
  title={`IPTV Premium France ${currentYear} — Serveurs Dédiés 10 Gbps & 4K 60 FPS`}
  description="Découvrez l'expérience IPTV Premium n°1 en France : infrastructure 10 Gbps dédiée, streaming 4K Ultra HD à 60 FPS, technologie Anti-Freeze 9.8™ et lecteur offert."
  canonicalURL="https://abonnement-iptv.cloud/iptv-premium"
  schema={productPremiumSchema}
  keywords={[
    'iptv premium',
    'abonnement iptv premium',
    'meilleur iptv premium',
    'iptv premium france',
    'serveur iptv premium 4k',
    'iptv premium sans coupure',
    'code iptv premium',
    'iptv premium 60 fps'
  ]}
>
  <!-- Sticky Global Navigation -->
  <StickyHeader currentPath="/iptv-premium" />

  <main id="main-content" class="flex-1">
    
    <!-- 1. Hero Conversion Section -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-[#07080E] overflow-hidden border-b border-white/[0.06]">
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[850px] h-[400px] bg-gradient-to-b from-[#0055D4]/25 via-[#60A5FA]/10 to-transparent rounded-full blur-[150px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left Column: Copy & Value Proposition -->
          <div class="lg:col-span-7 text-left">
            
            <!-- Badges -->
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider">
                <Sparkles class="w-3.5 h-3.5" />
                Norme Supérieure IPTV Premium
              </span>
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
                <Zap class="w-3.5 h-3.5" />
                Anti-Freeze 9.8™ · 60 FPS
              </span>
            </div>

            <!-- Main H1 with exact keyword focus -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15] mb-6">
              Abonnement <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#34D399]">
                IPTV Premium
              </span> en 4K UHD Réelle
            </h1>

            <!-- Primary Keyword within First 75 Words -->
            <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-8">
              Découvrez la référence de l'<strong>IPTV premium</strong> en France, conçue pour les téléspectateurs qui refusent les compromis. Profitez d'une architecture serveur européenne dédiée 10 Gbps, d'une diffusion native à 60 images par seconde sans aucun temps de chargement, et d'un zapping ultra-rapide sur tous vos écrans.
            </p>

            <!-- Feature Checklist Bullets -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-8">
              <div class="flex items-center gap-2.5 text-sm text-gray-200">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0" />
                <span>Flux direct 4K & 8K natif à 60 FPS</span>
              </div>
              <div class="flex items-center gap-2.5 text-sm text-gray-200">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0" />
                <span>Technologie Anti-Freeze 9.8™ anti-saturation</span>
              </div>
              <div class="flex items-center gap-2.5 text-sm text-gray-200">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0" />
                <span>Lecteur Premium offert avec le forfait 12 mois</span>
              </div>
              <div class="flex items-center gap-2.5 text-sm text-gray-200">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0" />
                <span>Activation instantanée en 2 min & garantie 24h</span>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a
                href={whatsappOrderUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#0055D4] via-[#2563EB] to-[#10B981] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(0,85,212,0.4)] hover:scale-[1.03] transition-all"
              >
                <MessageCircle class="w-5 h-5 text-emerald-200" />
                <span>Commander l'IPTV Premium (55 €/an)</span>
                <ArrowRight class="w-4 h-4" />
              </a>

              <a
                href={whatsappTestUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-[#11121C] hover:bg-[#161826] text-white font-bold text-sm border border-white/10 hover:border-emerald-500/40 transition-colors"
              >
                <Tv class="w-4 h-4 text-[#60A5FA]" />
                <span>Tester 24h sur WhatsApp</span>
              </a>
            </div>

            <!-- Rating & Trust Badge -->
            <div class="flex items-center gap-4 mt-8 pt-4 border-t border-white/[0.08] text-xs text-gray-300">
              <div class="flex text-amber-400">
                {[...Array(5)].map(() => (
                  <Star class="w-4 h-4 fill-amber-400" />
                ))}
              </div>
              <span class="font-bold text-white">4.97 / 5.0</span>
              <span>•</span>
              <span>2 150+ abonnés actifs ont choisi l'expérience Premium</span>
            </div>

          </div>

          <!-- Right Column: Visual Product Showcase -->
          <div class="lg:col-span-5">
            <div class="rounded-3xl overflow-hidden border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.8)] bg-[#111322] relative group">
              <img 
                src="/images/iptv-premium-hero.webp" 
                alt="Abonnement IPTV Premium France 2026 flux 4K UHD 60 FPS sans coupure sur Smart TV"
                class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
              <div class="p-6 bg-gradient-to-b from-[#111322] to-[#0A0B14]">
                <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
                  <span class="font-mono text-[#60A5FA]">STANDARD QUALITÉ SUPÉRIEURE</span>
                  <span class="text-emerald-400 font-bold">4K UHD · 60 FPS NATIF</span>
                </div>
                <h3 class="text-lg font-bold text-white mb-1">Clarté d'Image Cinéma & Sport en Direct</h3>
                <p class="text-xs text-gray-300">Serveurs fibre redondants avec élimination des micro-coupures et du buffering.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. Live Scores Carousel Section (Directly Under Hero) -->
    <LiveScores />

    <!-- 3. Technical Edge: The 6 Pillars of IPTV Premium -->
    <section class="py-20 md:py-28 bg-[#090A12] border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-4">
            <Award class="w-3.5 h-3.5" />
            <span>Excellence Technologique</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
            Pourquoi Choisir notre Service <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#34D399]">IPTV Premium</span> ?
          </h2>
          <p class="text-base text-gray-300 leading-relaxed">
            Chaque paramètre technique de notre réseau est optimisé pour reproduire la qualité d'une liaison satellite ou câble directe sans les contraintes de matériel lourd.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {technicalSpecs.map((spec) => (
            <div class="rounded-2xl bg-[#11121C] border border-white/[0.08] hover:border-[#0055D4]/50 p-7 transition-all duration-300 hover:-translate-y-1 group">
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-[#0055D4]/15 border border-[#0055D4]/30 flex items-center justify-center text-[#60A5FA] group-hover:scale-110 transition-transform">
                  <spec.icon class="w-6 h-6" />
                </div>
                <span class="text-[11px] font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full uppercase tracking-wider">
                  {spec.badge}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{spec.title}</h3>
              <p class="text-sm text-gray-400 leading-relaxed">{spec.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. Exclusive Comparison: IPTV Standard vs IPTV Premium -->
    <section class="py-20 md:py-28 bg-[#07080E] border-b border-white/[0.06]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/15 border border-[#DC2626]/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
            <ShieldCheck class="w-3.5 h-3.5" />
            <span>Comparatif Technique Objectif</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
