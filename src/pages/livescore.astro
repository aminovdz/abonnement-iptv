              </div>

              <!-- Scoreboard -->
              <div class="space-y-4 my-5 bg-[#0A0C16] p-4 rounded-2xl border border-white/[0.04]">
                <!-- Home Team -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <img 
                      src={match.homeLogo} 
                      alt={`Logo officiel club ${match.homeTeam}`} 
                      class="w-7 h-7 object-contain rounded-full bg-white/5 p-0.5"
                      width="28"
                      height="28"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span class="text-sm font-bold text-white group-hover:text-[#60A5FA] transition-colors">
                      {match.homeTeam}
                    </span>
                  </div>
                  <span class="text-2xl font-black text-white font-mono px-3.5 py-1 rounded-xl bg-black/60 border border-white/10 home-score-val">
                    {match.homeScore}
                  </span>
                </div>

                <!-- Away Team -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <img 
                      src={match.awayLogo} 
                      alt={`Logo officiel club ${match.awayTeam}`} 
                      class="w-7 h-7 object-contain rounded-full bg-white/5 p-0.5"
                      width="28"
                      height="28"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span class="text-sm font-bold text-white group-hover:text-[#60A5FA] transition-colors">
                      {match.awayTeam}
                    </span>
                  </div>
                  <span class="text-2xl font-black text-white font-mono px-3.5 py-1 rounded-xl bg-black/60 border border-white/10 away-score-val">
                    {match.awayScore}
                  </span>
                </div>
              </div>

              <!-- Channels Badge -->
              <div class="mb-4">
                <div class="text-[11px] text-gray-400 mb-1.5 flex items-center gap-1 font-medium">
                  <Tv class="w-3 h-3 text-[#60A5FA]" /> Chaînes disponibles sur notre bouquet :
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {match.broadcastChannels.map((ch) => (
                    <span class="px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/10 text-[10px] text-gray-300 font-medium">
                      {ch}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Card Bottom CTA -->
            <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
              <span class="text-[11px] font-semibold text-emerald-400 flex items-center gap-1">
                <Zap class="w-3 h-3" /> {match.quality}
              </span>

              <a
                href="https://wa.me/213550592200?text=Bonjour%21+Je+souhaite+regarder+le+match+en+direct+4K."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-[#0055D4] to-[#2563EB] text-white text-xs font-bold hover:shadow-[0_0_15px_rgba(0,85,212,0.4)] transition-all"
              >
                <span>Regarder</span>
                <PlayCircle class="w-3.5 h-3.5" />
