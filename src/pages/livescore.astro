<!-- Client Script for Live Filtering, Search, and Auto-Refresh -->
<script is:inline>
  (function initMatchCenter() {
    // 1. Filter by League
    const filterTabs = document.querySelectorAll('.filter-tab');
    const matchCards = document.querySelectorAll('.match-card');
    const noResultsMsg = document.getElementById('no-results-msg');
    let currentFilter = 'all';
    let currentSearch = '';

    function applyFilterAndSearch() {
      let visibleCount = 0;
      matchCards.forEach(card => {
        const league = card.getAttribute('data-league') || '';
        const home = card.getAttribute('data-home') || '';
        const away = card.getAttribute('data-away') || '';

        const matchesFilter = currentFilter === 'all' || league === currentFilter;
        const matchesSearch = !currentSearch || home.includes(currentSearch) || away.includes(currentSearch);

        if (matchesFilter && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('active', 'bg-[#0055D4]', 'text-white', 'shadow-md');
          t.classList.add('text-gray-300');
        });
        tab.classList.add('active', 'bg-[#0055D4]', 'text-white', 'shadow-md');
        tab.classList.remove('text-gray-300');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        applyFilterAndSearch();
      });
    });

    // 2. Search by Team
    const searchInput = document.getElementById('team-search-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        applyFilterAndSearch();
      });
    }

    // 3. Auto-Refresh Real-Time Scores
    async function updateMatchCenterScores() {
      try {
        const [resL1, resUCL, resEPL] = await Promise.allSettled([
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/fra.1/scoreboard').then(r => r.json()),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard').then(r => r.json()),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard').then(r => r.json())
        ]);

        const allEvents = [];
        if (resL1.status === 'fulfilled' && resL1.value?.events) allEvents.push(...resL1.value.events);
        if (resUCL.status === 'fulfilled' && resUCL.value?.events) allEvents.push(...resUCL.value.events);
        if (resEPL.status === 'fulfilled' && resEPL.value?.events) allEvents.push(...resEPL.value.events);

        allEvents.forEach(event => {
          const comp = event.competitions?.[0];
          const home = comp?.competitors?.find(c => c.homeAway === 'home');
          const away = comp?.competitors?.find(c => c.homeAway === 'away');
          if (!home || !away) return;

          const card = document.querySelector(`[data-match-id="${event.id}"]`);
          if (card) {
            const homeScoreEl = card.querySelector('.home-score-val');
            const awayScoreEl = card.querySelector('.away-score-val');
            const statusLabelEl = card.querySelector('.status-label');

            if (homeScoreEl) homeScoreEl.textContent = home.score || '0';
            if (awayScoreEl) awayScoreEl.textContent = away.score || '0';

            if (statusLabelEl) {
              const isLive = event.status?.type?.state === 'in';
              const isPost = event.status?.type?.state === 'post';
              if (isLive) {
                statusLabelEl.textContent = `${event.status?.displayClock || ''} En Direct`.trim();
              } else if (isPost) {
                statusLabelEl.textContent = `Score Final (${event.status?.type?.shortDetail || 'FT'})`;
              } else {
                statusLabelEl.textContent = event.status?.type?.detail || 'À venir';
              }
            }
          }
        });

        const statusEl = document.getElementById('matchcenter-refresh-status');
        if (statusEl) {
          const now = new Date();
          statusEl.textContent = `Actualisé à ${now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })} (Direct)`;
        }
      } catch (e) {
        // Silently preserve state on fetch error
      }
    }

    // Auto-poll every 30 seconds
    setInterval(updateMatchCenterScores, 30000);
  })();
</script>
