          />
        </div>

      </div>

      <!-- Match Cards Grid -->
      <div id="matches-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allMatches.map((match) => (
          <div 
            class="match-card rounded-3xl bg-[#121424] border border-white/[0.08] hover:border-[#0055D4]/50 p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl group"
