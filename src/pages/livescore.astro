            <div>
              <!-- League & Status Header -->
              <div class="flex items-center justify-between mb-5">
                <span class="text-xs font-bold text-[#60A5FA] flex items-center gap-1.5">
                  <Trophy class="w-3.5 h-3.5" />
                  {match.league}
                </span>

                {match.isLive ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-500/20 border border-red-500/40 text-red-400 text-[10px] font-black uppercase tracking-wider animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                    <span class="status-label">{match.status}</span>
                  </span>
                ) : (
                  <span class="text-[10px] font-bold text-gray-300 bg-white/[0.05] px-2.5 py-1 rounded-full border border-white/[0.06]">
                    <span class="status-label">{match.status}</span>
