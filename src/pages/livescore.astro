    isLive: false,
    quality: "4K UHD · 60 FPS",
    broadcastChannels: ["Canal+ Sport 360", "Sky Sports Main Event"]
  }
];

let allMatches: MatchItem[] = fallbackMatches;

try {
  const [resL1, resUCL, resEPL] = await Promise.allSettled([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/fra.1/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json()),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json()),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json())
  ]);

  const parseEvents = (data: any, leagueName: string, leagueKey: string): MatchItem[] => {
    if (!data?.events || !Array.isArray(data.events)) return [];
    return data.events.map((event: any) => {
      const comp = event.competitions?.[0];
      const home = comp?.competitors?.find((c: any) => c.homeAway === "home");
      const away = comp?.competitors?.find((c: any) => c.homeAway === "away");
      const isLive = event.status?.type?.state === "in";
      const isPost = event.status?.type?.state === "post";
      let statusText = event.status?.type?.detail || "À venir";
      if (isLive) {
        statusText = `${event.status?.displayClock || ''} En Direct`.trim();
      } else if (isPost) {
        statusText = `Score Final (${event.status?.type?.shortDetail || 'FT'})`;
      }
      return {
        id: String(event.id),
        league: leagueName,
        leagueKey,
        sport: "Football",
        homeTeam: home?.team?.displayName || home?.team?.name || "Équipe Domicile",
        homeLogo: home?.team?.logo || "https://a.espncdn.com/i/teamlogos/soccer/500/default-team-logo-500.png",
        homeScore: home?.score || "0",
        awayTeam: away?.team?.displayName || away?.team?.name || "Équipe Extérieure",
        awayLogo: away?.team?.logo || "https://a.espncdn.com/i/teamlogos/soccer/500/default-team-logo-500.png",
        awayScore: away?.score || "0",
        status: statusText,
        isLive,
        quality: "4K UHD · 60 FPS",
        broadcastChannels: ["Canal+ Sport", "BeIN Sports", "RMC Sport 4K", "DAZN"]
      };
    });
  };

  const l1 = resL1.status === "fulfilled" ? parseEvents(resL1.value, "Ligue 1 France", "ligue1") : [];
  const ucl = resUCL.status === "fulfilled" ? parseEvents(resUCL.value, "UEFA Champions League", "ucl") : [];
  const epl = resEPL.status === "fulfilled" ? parseEvents(resEPL.value, "Premier League Anglaise", "epl") : [];
  
  const combined = [...l1, ...ucl, ...epl];
  if (combined.length >= 4) {
    allMatches = combined;
  }
} catch {
  allMatches = fallbackMatches;
}

const currentYear = new Date().getFullYear();

// JSON-LD SportsEvent Schema for SEO
const matchCenterSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `Match Center en Direct ${currentYear} — Scores, Calendrier & Retransmissions 4K`,
  "description": "Suivez les scores officiels en direct de Ligue 1, UEFA Champions League et grands championnats européens. Retransmission 4K 60FPS sans coupure sur Abonnement IPTV France.",
  "url": "https://abonnement-iptv.cloud/livescore/",
  "subEvent": allMatches.map((m) => ({
    "@type": "SportsEvent",
    "name": `${m.homeTeam} vs ${m.awayTeam}`,
    "homeTeam": { "@type": "SportsTeam", "name": m.homeTeam },
    "awayTeam": { "@type": "SportsTeam", "name": m.awayTeam },
    "sport": m.sport,
    "description": `Rencontre ${m.league} — ${m.homeTeam} contre ${m.awayTeam}. Score en direct : ${m.homeScore} - ${m.awayScore}.`
  }))
};
---

<Layout
  title={`Match Center en Direct ${currentYear} — Scores Ligue 1, Champions League & Retransmission 4K`}
  description="Accédez au Match Center en direct : scores temps réel, résultats officiels de Ligue 1, UEFA Champions League et calendrier des diffusions en streaming 4K 60 FPS sans coupure."
  canonicalURL="https://abonnement-iptv.cloud/livescore/"
  schema={matchCenterSchema}
>
  <StickyHeader currentPath="/livescore/" />

  <main id="main-content" class="bg-[#090A12] min-h-screen">
    
    <!-- Hero Section -->
    <header class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#07080E] border-b border-white/[0.06] overflow-hidden">
      <!-- Ambient Lighting -->
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-[#DC2626]/15 rounded-full blur-[160px]"></div>
        <div class="absolute top-1/3 right-1/4 w-[400px] h-[250px] bg-[#0055D4]/15 rounded-full blur-[140px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Breadcrumb -->
        <nav class="inline-flex items-center gap-2 text-xs text-gray-400 mb-6" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <ChevronRight class="w-3.5 h-3.5 text-gray-600" />
          <span class="text-[#60A5FA] font-medium" aria-current="page">Match Center en Direct</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/15 border border-[#DC2626]/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
          <Radio class="w-3.5 h-3.5 animate-pulse" />
          <span>Scores & Résultats Officiels en Direct</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
          Match Center en Direct : <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">
            Ligue 1 & Coupes d'Europe en 4K UHD
          </span>
        </h1>

        <p class="text-base sm:text-lg text-gray-300 font-normal max-w-3xl mx-auto leading-relaxed mb-8">
          Consultez tous les scores en direct, les horaires de coup d'envoi et les chaînes de retransmission disponibles sur notre <a href="/#pricing" class="text-[#60A5FA] underline font-semibold hover:text-white">Abonnement IPTV France</a> en 4K 60 FPS sans décalage.
        </p>

        <!-- Live Sync Pill & Action -->
        <div class="inline-flex flex-wrap items-center justify-center gap-4 p-2 pl-4 rounded-2xl bg-[#111322] border border-white/10 shadow-xl max-w-xl mx-auto">
          <div class="flex items-center gap-2 text-xs text-gray-300">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span id="matchcenter-refresh-status" class="font-medium">Flux direct actualisé en continu</span>
          </div>

          <a 
            href="https://wa.me/213550592200?text=Bonjour%21+Je+souhaite+tester+le+streaming+sport+en+direct+4K." 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#0055D4] to-[#2563EB] text-white font-bold text-xs hover:shadow-[0_0_20px_rgba(0,85,212,0.4)] transition-all"
          >
            Tester en Direct (Essai 24h)
          </a>
        </div>
      </div>
    </header>

    <!-- Main Match Center Container -->
    <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Interactive Filter & Search Toolbar -->
      <div class="mb-10 flex flex-col md:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-[#111322] border border-white/[0.08]">
        
        <!-- League Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto" id="filter-tabs">
          <button 
            data-filter="all"
            class="filter-tab active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-[#0055D4] text-white shadow-md"
          >
            Tous les Matchs ({allMatches.length})
          </button>
          <button 
            data-filter="ligue1"
            class="filter-tab px-4 py-2 rounded-xl text-xs font-medium text-gray-300 hover:text-white hover:bg-white/[0.05] transition-all"
          >
            Ligue 1 France
          </button>
          <button 
            data-filter="ucl"
            class="filter-tab px-4 py-2 rounded-xl text-xs font-medium text-gray-300 hover:text-white hover:bg-white/[0.05] transition-all"
          >
            Champions League
          </button>
          <button 
            data-filter="epl"
            class="filter-tab px-4 py-2 rounded-xl text-xs font-medium text-gray-300 hover:text-white hover:bg-white/[0.05] transition-all"
          >
            Premier League
          </button>
        </div>

        <!-- Team Search Input -->
        <div class="relative w-full md:w-72">
          <Search class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
