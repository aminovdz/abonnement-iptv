  return citiesData.map((city) => ({
    params: { city: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;

// LocalBusiness JSON-LD Schema
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `France IPTV ${city.name} — Service d'Abonnement IPTV Premium`,
  "image": "https://abonnement-iptv.cloud/images/hero-bg.webp",
  "url": `https://abonnement-iptv.cloud/locations/${city.slug}`,
  "telephone": "+18036582620",
  "priceRange": "8€ - 55€",
  "description": `Fournisseur d'abonnement IPTV haute performance à ${city.name} (${city.region}). Serveurs locaux fibre 10 Gbps, anti-freeze et support 24/7 en français.`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city.name,
    "addressRegion": city.region,
    "postalCode": city.postalCode,
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": city.coordinates.latitude,
    "longitude": city.coordinates.longitude
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  },
  "areaServed": [
    {
      "@type": "City",
      "name": city.name
    },
    {
      "@type": "AdministrativeArea",
      "name": city.region
    },
    {
      "@type": "Country",
      "name": "France"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.94",
    "reviewCount": "1840",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Julien Delorme" },
      "datePublished": "2026-08-28",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      },
      "reviewBody": `Excellente qualité de flux à ${city.name}. Zéro coupure pendant la Ligue 1 et activation très rapide.`
    }
  ]
};

const localFaqs = [
  {
    q: `Comment fonctionne l'abonnement IPTV à ${city.name} ?`,
    a: `À ${city.name}, notre service s'appuie sur des serveurs CDN interconnectés aux points d'échange régionaux (${city.datacenterHub}). Dès votre commande validée, vous recevez vos identifiants m3u / Xtream par email et WhatsApp en moins de 2 minutes pour configurer votre Smart TV connectée, clé multimédia TV 4K ou boîtier de salon.`
  },
  {
    q: `L'IPTV fonctionne-t-il bien avec ma box internet à ${city.name} ?`,
    a: `Oui, absolument. Notre flux est 100% optimisé pour tous les opérateurs français majeurs déployés à ${city.name} (${city.isps}). Notre protocole Anti-Freeze 9.8™ utilise un chiffrement SSL 256 bits qui contourne le bridage vidéo occasionnel des FAI aux heures de forte affluence.`
  },
  {
    q: `Puis-je regarder les matchs de ${city.localClub} et la Ligue 1 en 4K ?`,
    a: `Parfaitement. Tous les matchs de Ligue 1, de Ligue des Champions et les rencontres de ${city.localClub} sont diffusés en 4K et Full HD 60 images par seconde avec les commentaires en français d'origine, sans aucun délai ni décalage de score.`
  },
  {
    q: `Quel est le prix de l'abonnement IPTV pour les résidents de ${city.name} ?`,
    a: `Nos tarifs sont transparents : l'abonnement 12 Mois est à 55 € (soit ~4,58 €/mois) avec une application Lecteur Premium offerte. Nous proposons également les formules 6 Mois (30 €), 3 Mois (20 €) et 1 Mois (8 €), toutes sans engagement.`
  }
];
---

<Layout
  title={city.metaTitle}
  description={city.metaDescription}
  canonicalURL={`https://abonnement-iptv.cloud/locations/${city.slug}`}
  schema={localBusinessSchema}
>
  <StickyHeader />

  <main id="main-content">
    
    <!-- Local Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-[#07080E] overflow-hidden border-b border-white/[0.06]">
      <!-- Background Ambient Glow -->
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-[#0055D4]/15 rounded-full blur-[140px]"></div>
        <div class="absolute top-1/3 right-10 w-[350px] h-[350px] bg-[#DC2626]/10 rounded-full blur-[120px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-gray-400 mb-8" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <ChevronRight class="w-3.5 h-3.5 text-gray-600" />
          <a href="/#cities-list" class="hover:text-white transition-colors">France</a>
          <ChevronRight class="w-3.5 h-3.5 text-gray-600" />
          <span class="text-[#60A5FA] font-medium" aria-current="page">{city.name}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7">
            <!-- Local Hub Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-6">
              <MapPin class="w-3.5 h-3.5 text-[#DC2626]" />
              <span>Nœud Régional Dédié : {city.name} ({city.postalCode})</span>
            </div>

            <!-- Main H1 with exact high-volume keywords -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12] mb-6">
              Abonnement IPTV à <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">{city.name}</span> — Streaming 4K Ultra Fluide
            </h1>

            <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-6">
              Bénéficiez du meilleur service <strong>d'abonnement IPTV à {city.name}</strong> et en {city.region}. 
              Interconnecté aux datacenters locaux <em>({city.datacenterHub})</em>, profitez d'un zapping ultra-rapide sous la seconde et d'une fluidité 60 FPS sans coupure, même lors des grands matchs de {city.localClub}.
            </p>

            <!-- Local context highlight card -->
            <div class="p-4 rounded-xl bg-[#121422] border border-white/[0.08] mb-8">
              <p class="text-xs text-gray-300 leading-relaxed font-normal">
                {city.localDetails}
              </p>
              <div class="mt-3 pt-3 border-t border-white/[0.06] flex flex-wrap items-center gap-4 text-[11px] text-gray-400">
                <span class="flex items-center gap-1.5 text-emerald-400 font-semibold">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Latence mesurée : {city.latency}
                </span>
                <span>•</span>
                <span>Hub : {city.datacenterHub}</span>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a
                href="#pricing"
                class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-[#0055D4] to-[#2563EB] text-white font-bold text-base hover:shadow-[0_0_25px_rgba(0,85,212,0.45)] transition-all transform hover:-translate-y-0.5 active:translate-y-0"
              >
                <span>Voir les Abonnements dès 55 €/an</span>
                <ArrowRight class="w-4 h-4" />
              </a>

              <a
                href="https://wa.me/18036582620?text=Bonjour,%20je%20souhaite%20un%20test%20ou%20un%20abonnement%20IPTV%20pour%20la%20ville%20de%20"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-[#151726] hover:bg-[#1B1E30] text-gray-200 border border-white/10 font-bold text-sm hover:border-[#25D366]/40 transition-all text-center"
              >
                <span>Assistance WhatsApp 24/7</span>
              </a>
            </div>

            <!-- Reassurance micro-badges -->
            <div class="mt-8 flex flex-wrap items-center gap-5 text-xs text-gray-400">
              <span class="flex items-center gap-1.5 text-gray-300">
                <CheckCircle2 class="w-4 h-4 text-emerald-400" /> Activation sous 2 minutes
              </span>
              <span class="flex items-center gap-1.5 text-gray-300">
                <CheckCircle2 class="w-4 h-4 text-emerald-400" /> Compatible box fibre de tous les opérateurs
              </span>
              <span class="flex items-center gap-1.5 text-gray-300">
                <CheckCircle2 class="w-4 h-4 text-emerald-400" /> Lecteur Premium Offert
              </span>
            </div>

          </div>

          <!-- Right Column: Local Performance Card -->
          <div class="lg:col-span-5">
            <div class="relative rounded-2xl bg-gradient-to-b from-[#141628] to-[#0D0E1A] p-6 sm:p-8 border border-white/10 shadow-2xl">
              
              <div class="flex items-center justify-between pb-5 border-b border-white/[0.08] mb-6">
                <div>
                  <span class="text-xs uppercase tracking-wider text-gray-400 font-bold">Réseau Régional</span>
                  <h2 class="text-xl font-black text-white">{city.name} Métropole</h2>
                </div>
                <div class="px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                  Opérationnel
                </div>
              </div>

              <!-- CDN Network Visual Illustration -->
              <div class="rounded-xl overflow-hidden mb-6 border border-white/[0.08] shadow-md group">
                <img 
                  src="/images/reseau-france-cdn.webp" 
                  alt={`Réseau CDN haute performance et serveurs locaux à ${city.name}`} 
                  class="w-full h-36 object-cover transition-transform duration-700 group-hover:scale-105"
                  width="1200"
                  height="675"
                  loading="eager"
                  decoding="async"
                />
              </div>

              <!-- Metrics -->
              <div class="space-y-4 mb-6">
                <div class="p-3.5 rounded-xl bg-[#090A12] border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <Server class="w-4 h-4 text-[#60A5FA]" />
                    <span class="text-xs text-gray-300">Serveurs de diffusion</span>
                  </div>
                  <span class="text-xs font-bold text-white">Cluster Fibre 10 Gbps</span>
                </div>

                <div class="p-3.5 rounded-xl bg-[#090A12] border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <Wifi class="w-4 h-4 text-emerald-400" />
                    <span class="text-xs text-gray-300">Compatibilité FAI {city.name}</span>
                  </div>
                  <span class="text-xs font-bold text-emerald-400">100% Sans Bridage</span>
                </div>

                <div class="p-3.5 rounded-xl bg-[#090A12] border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <Tv class="w-4 h-4 text-[#DC2626]" />
                    <span class="text-xs text-gray-300">Support Football & Sport</span>
                  </div>
                  <span class="text-xs font-bold text-white">Ligue 1 & {city.localClub}</span>
                </div>

                <div class="p-3.5 rounded-xl bg-[#090A12] border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <Zap class="w-4 h-4 text-amber-400" />
                    <span class="text-xs text-gray-300">Technologie Anti-Freeze</span>
                  </div>
                  <span class="text-xs font-bold text-amber-400">Anti-Freeze 9.8™ Actif</span>
                </div>
              </div>

              <!-- Guaranteed Speeds -->
              <div class="rounded-xl bg-[#0055D4]/10 border border-[#0055D4]/20 p-4">
                <p class="text-xs text-gray-200 leading-relaxed font-normal">
                  💡 <strong>Conseil technique pour {city.name} :</strong> Compatible avec toutes les box internet ({city.isps}). Fonctionne également en 4G/5G en déplacement sans VPN requis.
                </p>
              </div>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Core Features Grid -->
    <FeatureGrid />

    <!-- Pricing Card (12 Months 55€ prominently first) -->
    <PricingCard />

    <!-- Process Steps -->
    <ProcessSteps />

    <!-- Supported Devices -->
    <SupportedDevices />

    <!-- Local City FAQs -->
    <section class="py-20 md:py-28 bg-[#090A14] border-t border-white/[0.06]" aria-labelledby="local-faq-title">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-14">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-4">
            <HelpCircle class="w-3.5 h-3.5" />
            <span>Foire Aux Questions</span>
          </div>
          <h2 id="local-faq-title" class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Questions Fréquentes — Abonnement IPTV à {city.name}
          </h2>
          <p class="text-sm sm:text-base text-gray-300 font-normal">
            Tout ce qu'il faut savoir avant de commander votre abonnement IPTV en région {city.region}.
          </p>
        </div>

        <div class="space-y-4">
          {localFaqs.map((faq, index) => (
            <div class="rounded-2xl bg-[#121422] border border-white/[0.08] p-6 hover:border-[#0055D4]/40 transition-colors">
              <h3 class="text-lg font-bold text-white mb-3 flex items-start gap-3">
                <span class="text-[#0055D4] font-black">{index + 1}.</span>
                <span>{faq.q}</span>
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed font-normal pl-7">
                {faq.a}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <CTASection />

  </main>

  <Footer />

  <!-- Floating Engagement Widgets -->
  <FloatingWhatsApp />
  <SocialPopup />
  <ExitPopup />
  <GroupsPopup />

</Layout>
