---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import ExitPopup from '../../components/ExitPopup.astro';
import SocialPopup from '../../components/SocialPopup.astro';
import GroupsPopup from '../../components/GroupsPopup.astro';
import { getCollection } from 'astro:content';
import { 
  Calendar, 
  Clock, 
  User, 
  ChevronRight, 
  ArrowLeft, 
  ArrowRight,
  Share2, 
  CheckCircle2,
  Sparkles,
  ShieldCheck,
  MessageCircle,
  Send
} from 'lucide-astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();

// Related guides
const allGuides = await getCollection('guides');
const relatedGuides = allGuides
  .filter((g) => g.slug !== guide.slug)
  .slice(0, 2);

// Article Schema (JSON-LD)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.data.title,
  "description": guide.data.description,
  "image": `https://abonnement-iptv.cloud${guide.data.image}`,
  "datePublished": guide.data.pubDate.toISOString(),
  "dateModified": (guide.data.updatedDate || guide.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": guide.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Abonnement IPTV France",
    "logo": {
      "@type": "ImageObject",
      "url": "https://abonnement-iptv.cloud/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://abonnement-iptv.cloud/guides/${guide.slug}`
  }
};

const currentUrl = `https://abonnement-iptv.cloud/guides/${guide.slug}`;
const shareText = encodeURIComponent(`${guide.data.title} — À lire absolument : `);
const shareUrl = encodeURIComponent(currentUrl);
---

<Layout
  title={`${guide.data.title} — France IPTV`}
  description={guide.data.description}
  canonicalURL={currentUrl}
  type="article"
  publishedTime={guide.data.pubDate.toISOString()}
  modifiedTime={(guide.data.updatedDate || guide.data.pubDate).toISOString()}
  schema={articleSchema}
>
  <StickyHeader />

  <main id="main-content">
    
    <!-- Article Header -->
    <header class="relative pt-32 pb-14 md:pt-40 md:pb-20 bg-[#07080E] border-b border-white/[0.06] overflow-hidden">
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-[#0055D4]/15 rounded-full blur-[140px]"></div>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <ChevronRight class="w-3.5 h-3.5 text-gray-600" />
          <a href="/guides" class="hover:text-white transition-colors">Guides</a>
          <ChevronRight class="w-3.5 h-3.5 text-gray-600" />
          <span class="text-[#60A5FA] font-medium truncate max-w-[260px] sm:max-w-none">{guide.data.title}</span>
        </nav>

        <!-- Category & Time Badges -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400 mb-4">
          <span class="px-3 py-1 rounded-full bg-[#0055D4]/20 border border-[#0055D4]/30 text-[#60A5FA] font-bold">
            {guide.data.category}
          </span>
          <span class="flex items-center gap-1.5">
            <Clock class="w-3.5 h-3.5 text-gray-400" /> {guide.data.readingTime}
          </span>
          <span>•</span>
          <span class="flex items-center gap-1.5">
            <Calendar class="w-3.5 h-3.5 text-gray-400" /> 
            {guide.data.pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
          </span>
        </div>

        <!-- Main H1 Article Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          {guide.data.title}
        </h1>

        <p class="text-base sm:text-lg text-gray-300 leading-relaxed font-normal mb-8">
          {guide.data.description}
        </p>

        <!-- Author Byline & Social Share -->
        <div class="pt-6 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#161A30] border border-white/10 flex items-center justify-center text-[#60A5FA]">
              <User class="w-5 h-5" />
            </div>
            <div>
              <div class="text-xs font-bold text-white">{guide.data.author}</div>
              <div class="text-[11px] text-gray-400">Équipe Technique & Rédaction France IPTV</div>
            </div>
          </div>

          <!-- Share buttons -->
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-400 mr-1 flex items-center gap-1">
              <Share2 class="w-3.5 h-3.5" /> Partager :
            </span>
            <a
              href={`https://api.whatsapp.com/send?text=${shareText}${shareUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-[#25D366]/15 hover:bg-[#25D366]/30 text-[#25D366] flex items-center justify-center transition-colors"
              aria-label="Partager sur WhatsApp"
            >
              <MessageCircle class="w-4 h-4" />
            </a>
            <a
              href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-[#229ED9]/15 hover:bg-[#229ED9]/30 text-[#229ED9] flex items-center justify-center transition-colors"
              aria-label="Partager sur Telegram"
            >
              <Send class="w-4 h-4" />
            </a>
          </div>
        </div>

      </div>
    </header>

    <!-- Article Content & Sidebar -->
    <div class="py-14 md:py-20 bg-[#090A12]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Featured Image Banner -->
        <div class="mb-10 rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-[#111322]">
          <img 
            src={guide.data.image} 
            alt={guide.data.imageAlt || guide.data.title}
            width="1200"
            height="675"
            class="w-full h-auto object-cover max-h-[460px]"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Promotional Conversion Banner Before Reading -->
        <div class="mb-12 rounded-2xl bg-gradient-to-r from-[#0055D4]/15 via-[#101428] to-[#DC2626]/10 border border-[#0055D4]/30 p-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[11px] font-bold mb-2">
              <Sparkles class="w-3 h-3" /> Offre Spéciale Lecteurs
            </div>
            <h2 class="text-base sm:text-lg font-black text-white">
              Formule 12 Mois : 55 € tout inclus + Lecteur Offert
            </h2>
            <p class="text-xs text-gray-300 font-normal">
              Activation sous 2 minutes par WhatsApp. Technologie Anti-Freeze 9.8™ et 4K 60FPS.
            </p>
          </div>
          <a
            href="/#pricing"
            class="shrink-0 px-5 py-3 rounded-xl bg-gradient-to-r from-[#0055D4] to-[#2563EB] text-white font-bold text-xs hover:shadow-[0_0_20px_rgba(0,85,212,0.4)] transition-all"
          >
            Voir l'Offre 55 €
          </a>
        </div>

        <!-- Markdown Body -->
        <article class="prose prose-invert max-w-none 
          prose-headings:font-black prose-headings:tracking-tight prose-headings:text-white
          prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-b prose-h2:border-white/[0.08] prose-h2:pb-3
          prose-h3:text-lg prose-h3:sm:text-xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-[#60A5FA]
          prose-p:text-gray-300 prose-p:leading-relaxed prose-p:text-base prose-p:font-normal prose-p:mb-6
          prose-li:text-gray-300 prose-li:text-base prose-li:font-normal
          prose-strong:text-white prose-strong:font-bold
          prose-blockquote:border-l-4 prose-blockquote:border-[#0055D4] prose-blockquote:bg-[#111322] prose-blockquote:p-4 prose-blockquote:rounded-r-xl prose-blockquote:italic prose-blockquote:text-gray-300
          prose-table:w-full prose-table:border-collapse prose-table:my-8
          prose-th:bg-[#141728] prose-th:p-3.5 prose-th:text-xs prose-th:font-bold prose-th:text-white prose-th:border prose-th:border-white/10
          prose-td:p-3.5 prose-td:text-xs prose-td:sm:text-sm prose-td:text-gray-300 prose-td:border prose-td:border-white/[0.08] prose-tr:hover:bg-white/[0.02]"
        >
          <Content />
        </article>

        <!-- Mid-article Trust Box -->
        <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-[#111322] border border-white/[0.08] shadow-lg">
          <div class="flex items-center gap-3 mb-4">
            <ShieldCheck class="w-6 h-6 text-emerald-400" />
            <h2 class="text-lg font-black text-white">Pourquoi nous faire confiance ?</h2>
          </div>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal mb-6">
            Notre service est conçu pour les amateurs de sport exigeants qui refusent le buffering lors d'une demi-finale de Ligue des Champions ou du Classique. Grâce à notre infrastructure redondante et notre assistance 24/7 en français, vous profitez de votre écran sans stress.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-gray-300">
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Garantie 24h satisfait ou remboursé</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Zéro engagement tacite</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Serveurs 10 Gbps anti-freeze</span>
            </div>
          </div>
        </div>

        <!-- Tags List -->
        <div class="mt-10 pt-6 border-t border-white/[0.08] flex flex-wrap items-center gap-2">
          <span class="text-xs text-gray-400 mr-2">Mots-clés associés :</span>
          {guide.data.tags.map((tag) => (
            <span class="px-3 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-gray-300">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Back to Guides / Navigation -->
        <div class="mt-12 flex items-center justify-between">
          <a
            href="/guides"
            class="inline-flex items-center gap-2 text-xs font-bold text-gray-400 hover:text-white transition-colors"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>Retour à tous les guides</span>
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center gap-2 text-xs font-bold text-[#60A5FA] hover:underline"
          >
            <span>Passer commande</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

      </div>
    </div>

    <!-- Related Articles Section -->
    {relatedGuides.length > 0 && (
      <section class="py-16 bg-[#07080E] border-t border-white/[0.06]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-xl font-black text-white mb-6">Articles Recommandés</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedGuides.map((rel) => (
              <a
                href={`/guides/${rel.slug}`}
                class="rounded-2xl bg-[#111322] border border-white/[0.08] hover:border-[#0055D4]/40 p-5 flex flex-col justify-between transition-all group"
              >
                <div>
                  <div class="overflow-hidden rounded-xl mb-3.5 border border-white/[0.06]">
                    <img 
                      src={rel.data.image} 
                      alt={rel.data.imageAlt || rel.data.title}
                      class="w-full h-32 object-cover transition-transform duration-500 group-hover:scale-105"
                      width="400"
                      height="225"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="text-[11px] text-[#60A5FA] font-bold uppercase tracking-wider mb-2">
                    {rel.data.category}
                  </div>
                  <h3 class="text-base font-bold text-white group-hover:text-[#60A5FA] transition-colors leading-snug mb-2">
                    {rel.data.title}
                  </h3>
                  <p class="text-xs text-gray-400 line-clamp-2 font-normal">
                    {rel.data.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs text-gray-400">
                  <span>{rel.data.readingTime}</span>
                  <span class="text-[#60A5FA] font-semibold group-hover:translate-x-1 transition-transform">Lire ›</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom Conversion CTA -->
    <CTASection />

  </main>

  <Footer />

  <FloatingWhatsApp />
  <SocialPopup />
  <ExitPopup />
  <GroupsPopup />

</Layout>
