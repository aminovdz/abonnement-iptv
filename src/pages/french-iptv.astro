          <div class="lg:col-span-6 space-y-4">
            
            <div class="p-5 rounded-2xl bg-[#121424] border border-white/[0.08] flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-[#60A5FA] flex items-center justify-center shrink-0">
                <Globe2 class="w-5 h-5" />
              </div>
              <div>
