  "image": "https://abonnement-iptv.cloud/images/french-iptv-hero.webp",
  "description": "Premium French IPTV subscription with stable 4K 60FPS streaming, Anti-Freeze 9.8™ technology, French sports networks, cinema, VOD and instant 2-minute WhatsApp activation worldwide.",
  "brand": {
    "@type": "Brand",
    "name": "France IPTV"
  },
  "sku": "FRENCH-IPTV-2025",
  "mpn": "FRENCH-IPTV-PRO",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.95",
    "bestRating": "5.0",
    "worstRating": "1.0",
    "ratingCount": "2460",
    "reviewCount": "2460"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "lowPrice": "8.00",
    "highPrice": "55.00",
    "offerCount": "4",
    "offers": [
      {
        "@type": "Offer",
        "name": "French IPTV 12 Months (Best Value)",
        "price": "55.00",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock",
        "url": "https://abonnement-iptv.cloud/french-iptv"
      },
      {
        "@type": "Offer",
        "name": "French IPTV 6 Months",
        "price": "30.00",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock",
