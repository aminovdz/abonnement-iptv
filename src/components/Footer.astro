---
import { Tv, Mail, MessageCircle, Send, MapPin, Lock, ExternalLink } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const cities = [
  { name: 'Paris', slug: 'paris', region: 'Île-de-France' },
  { name: 'Marseille', slug: 'marseille', region: 'Provence-Alpes-Côte d\'Azur' },
  { name: 'Lyon', slug: 'lyon', region: 'Auvergne-Rhône-Alpes' },
  { name: 'Toulouse', slug: 'toulouse', region: 'Occitanie' },
  { name: 'Nice', slug: 'nice', region: 'Provence-Alpes-Côte d\'Azur' },
  { name: 'Nantes', slug: 'nantes', region: 'Pays de la Loire' },
  { name: 'Strasbourg', slug: 'strasbourg', region: 'Grand Est' },
  { name: 'Montpellier', slug: 'montpellier', region: 'Occitanie' },
  { name: 'Bordeaux', slug: 'bordeaux', region: 'Nouvelle-Aquitaine' },
  { name: 'Lille', slug: 'lille', region: 'Hauts-de-France' }
];

const quickLinks = [
  { name: 'Accueil', href: '/' },
  { name: 'Formule 12 Mois (Bestseller)', href: '/abonnement-iptv-12-mois' },
  { name: 'French IPTV (Worldwide)', href: '/french-iptv' },
  { name: 'IPTV Premium (4K/8K)', href: '/iptv-premium' },
  { name: 'Code IPTV & M3U', href: '/code-iptv' },
  { name: 'Grille Tarifaire', href: '/#pricing' },
  { name: 'Programme Parrainage', href: '/referral' },
  { name: 'Contact & Support', href: '/contact' }
];

const comparisonLinks = [
  { name: 'Abonnement IPTV vs AcheterIPTVPro', href: '/compare/abonnement-iptv-vs-acheteriptvpro' },
  { name: 'Abonnement IPTV vs AbonnementsIPTV-Premium', href: '/compare/abonnement-iptv-vs-abonnementsiptv-premium' },
  { name: 'Abonnement IPTV vs IPTV-PremiumFrance', href: '/compare/abonnement-iptv-vs-iptv-premiumfrance' },
  { name: 'Abonnement IPTV vs Bouquets TV Traditionnels', href: '/compare/abonnement-iptv-vs-cable-traditionnel' }
];

const guidesLinks = [
  { name: 'Comment Regarder la Ligue 1 en Direct 4K', href: '/guides/comment-regarder-la-ligue-1-en-direct' },
  { name: 'L\'IPTV est-il légal en France ? Ce que dit la loi', href: '/guides/iptv-est-il-legal-en-france' },
  { name: 'Meilleure application IPTV pour Smart TV', href: '/guides/meilleure-application-iptv-smart-tv-fire-stick' },
  { name: 'Tous les Guides & Tutoriels', href: '/guides' }
];

const legalLinks = [
  { name: 'Politique de Confidentialité (RGPD)', href: '/privacy' },
  { name: 'Conditions Générales de Vente (CGV)', href: '/terms' },
  { name: 'Politique de Remboursement (24h)', href: '/refund' },
  { name: 'Notification DMCA & Droits d\'Auteur', href: '/dmca' },
  { name: 'Mentions Légales & Disclaimer', href: '/disclaimer' }
];
---

<footer class="bg-[#06070B] border-t border-white/[0.08] text-gray-400 text-sm relative" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pied de page Abonnement IPTV France</h2>

  <!-- Top Community Bar: WhatsApp & Telegram Channels -->
  <div class="border-b border-white/[0.06] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-[#0E101A] rounded-2xl p-6 sm:p-8 border border-white/[0.06]">
        <div>
          <h3 class="text-xl font-bold text-white mb-2">
            Rejoignez les Canaux Officiels d'Abonnement IPTV France
          </h3>
          <p class="text-gray-400 text-xs sm:text-sm max-w-xl">
            Restez informé du calendrier des retransmissions sportives, des optimisations de serveurs et des réductions exclusives sur les abonnements.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
          <a
            href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#10B981]/15 hover:bg-[#10B981]/25 text-[#10B981] border border-[#10B981]/30 text-xs font-bold uppercase tracking-wider transition-colors"
            aria-label="Rejoindre la chaîne WhatsApp officielle"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Chaîne WhatsApp</span>
            <ExternalLink class="w-3 h-3 ml-0.5 opacity-70" />
          </a>
          <a
            href="https://t.me/castvera_com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#0055D4]/15 hover:bg-[#0055D4]/25 text-[#60A5FA] border border-[#0055D4]/30 text-xs font-bold uppercase tracking-wider transition-colors"
            aria-label="Rejoindre le canal Telegram"
          >
            <Send class="w-4 h-4" />
            <span>Canal Telegram</span>
            <ExternalLink class="w-3 h-3 ml-0.5 opacity-70" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Multi-Column Navigation Links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & Summary Info (2 cols on lg) -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-4 group" aria-label="Abonnement IPTV France">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#121422] to-[#090A10] border border-[#0055D4]/40 flex items-center justify-center">
            <Tv class="w-4 h-4 text-[#0055D4]" />
          </div>
          <span class="font-black text-xl text-white tracking-tight">
            ABONNEMENT <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0055D4] via-[#60A5FA] to-[#DC2626]">IPTV</span>
          </span>
        </a>
        
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-6 max-w-sm">
          Votre référence en France pour le streaming haute définition en 4K Ultra HD. Infrastructure serveur haut débit, technologie Anti-Freeze 9.8™ et support technique en direct.
        </p>

        <!-- Direct Contact Points -->
        <div class="space-y-2.5 text-xs text-gray-300">
          <div class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-[#0055D4] shrink-0" />
            <a href="mailto:contact@abonnement-iptv.cloud" class="hover:text-white transition-colors">contact@abonnement-iptv.cloud</a>
          </div>
          <div class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-gray-400 shrink-0" />
            <a href="mailto:support@castvera.com" class="hover:text-white transition-colors">support@castvera.com</a>
          </div>
          <div class="flex items-center gap-2.5">
            <MessageCircle class="w-4 h-4 text-[#10B981] shrink-0" />
            <a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp : +1 803 658 2620</a>
          </div>
        </div>
      </div>

      <!-- Quick Navigation Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Navigation
        </h4>
        <ul class="space-y-2.5 text-xs">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#60A5FA] transition-colors flex items-center gap-1.5">
                <span class="text-gray-600">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Comparisons & Guides -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Comparatifs & Guides
        </h4>
        <ul class="space-y-2.5 text-xs">
          {comparisonLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#60A5FA] transition-colors flex items-center gap-1.5">
                <span class="text-gray-600">›</span> {link.name}
              </a>
            </li>
          ))}
          {guidesLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#60A5FA] transition-colors flex items-center gap-1.5">
                <span class="text-gray-600">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal & Security -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">
          Cadre Légal & Sécurité
        </h4>
        <ul class="space-y-2.5 text-xs">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#60A5FA] transition-colors flex items-center gap-1.5">
                <span class="text-gray-600">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-6 p-3 rounded-xl bg-white/[0.03] border border-white/[0.05] text-[11px] text-gray-400">
          <div class="flex items-center gap-1 text-[#10B981] font-semibold mb-1">
            <Lock class="w-3 h-3" /> Chiffrement SSL 256 bits
          </div>
          <span>Données et transactions protégées sur le réseau Cloudflare Edge.</span>
        </div>
      </div>

    </div>

    <!-- France Location Map & Programmatic City Links -->
    <div id="cities" class="mt-14 pt-10 border-t border-white/[0.06]">
      <div class="flex items-center gap-2 mb-4">
        <MapPin class="w-4 h-4 text-[#DC2626]" />
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">
          Disponibilité Haute Vitesse par Région & Métropole en France
        </h4>
      </div>
      <p class="text-xs text-gray-400 mb-6">
        Nos serveurs de diffusion sont connectés directement aux principaux nœuds d'interconnexion réseau français (TH2, Equinix Paris, LyonIX, Marseille Interxion) pour garantir une latence sous les 15 millisecondes dans toutes les régions.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {cities.map((city) => (
          <a
            href={`/locations/${city.slug}`}
            class="p-2.5 rounded-lg bg-[#11121C]/60 hover:bg-[#161826] border border-white/[0.05] hover:border-[#0055D4]/40 transition-colors text-xs text-gray-300 hover:text-white flex flex-col"
          >
            <span class="font-semibold text-white">Abonnement IPTV {city.name}</span>
            <span class="text-[10px] text-gray-500">{city.region}</span>
          </a>
        ))}
      </div>
    </div>

  </div>

  <!-- Bottom Legal & Disclaimer Bar -->
  <div class="border-t border-white/[0.06] bg-[#040508] py-8 text-xs text-gray-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <div>
        <p>© {currentYear} Abonnement IPTV France (<a href="https://abonnement-iptv.cloud" class="hover:text-white">abonnement-iptv.cloud</a>). Tous droits réservés.</p>
        <p class="text-[11px] text-gray-400 mt-1">
          Avertissement légal : Nous opérons comme fournisseur indépendant d'infrastructures de transmission et de serveurs multimédias. Nous ne stockons ni ne diffusons de contenus propriétaires sur nos serveurs.
        </p>
      </div>

      <div class="flex items-center gap-4 text-xs">
        <a href="/privacy" class="hover:text-white transition-colors">Confidentialité</a>
        <span>•</span>
        <a href="/terms" class="hover:text-white transition-colors">CGV</a>
        <span>•</span>
        <a href="/refund" class="hover:text-white transition-colors">Remboursement 24h</a>
        <span>•</span>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
