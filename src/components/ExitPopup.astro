---
import { MessageCircle, X, Clock, Gift } from 'lucide-astro';

const whatsappOfferUrl = "https://wa.me/18036582620?text=Bonjour%21+Je+souhaite+profiter+de+l%27offre+sp%C3%A9ciale+:+Abonnez-vous+maintenant+et+recevez+1+mois+gratuit.";
---

<div
  id="exit-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <div class="relative w-full max-w-lg rounded-3xl bg-gradient-to-b from-[#14182E] via-[#0F111E] to-[#080910] border-2 border-[#0055D4]/70 p-6 sm:p-8 shadow-[0_0_60px_rgba(0,85,212,0.4)] text-center transform scale-95 transition-transform duration-300 overflow-hidden">
    
    <!-- Top Ambient Accent -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-32 bg-[#0055D4]/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <!-- Close Button -->
    <button
      id="close-exit-popup"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#0055D4]"
      aria-label="Fermer cette offre"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Gift Icon Emblem -->
    <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-gradient-to-br from-[#0055D4] to-[#1E40AF] flex items-center justify-center shadow-[0_0_25px_rgba(0,85,212,0.5)]">
      <Gift class="w-8 h-8 text-white" />
    </div>

    <!-- Urgency Badge -->
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#0055D4]/20 border border-[#0055D4]/40 text-[#60A5FA] text-[11px] font-black uppercase tracking-wider mb-3">
      <Clock class="w-3.5 h-3.5" />
      <span>Offre Spéciale Dernière Chance</span>
    </div>

    <!-- Main Title -->
    <h2 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
      Attendez ! Ne Partez Pas Les Mains Vides
    </h2>

    <!-- Mandatory Offer: Subscribe now and get 1 month free -->
    <p class="text-lg sm:text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171] mb-3">
      Abonnez-vous maintenant et recevez 1 mois gratuit !
    </p>

    <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
      Bénéficiez immédiatement de notre streaming Ultra HD 4K avec technologie Anti-Freeze 9.8™, support en direct 24/7 et sans engagement de durée.
    </p>

    <!-- Highlights Checklist -->
    <div class="bg-black/50 rounded-2xl p-4 border border-white/5 mb-6 text-xs text-gray-300 space-y-2 text-left">
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span><strong>+1 mois offert</strong> ajouté immédiatement à votre formule</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>Activation express sur WhatsApp en moins de 2 minutes</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>Garantie satisfait ou remboursé sous 24 heures</span>
      </div>
    </div>

    <!-- CTA Button linking to WhatsApp -->
    <div class="flex flex-col gap-3">
      <a
        id="exit-popup-cta"
        href={whatsappOfferUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-[#0055D4] via-[#1E40AF] to-[#0055D4] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(0,85,212,0.5)] hover:shadow-[0_0_40px_rgba(0,85,212,0.7)] transition-all duration-300 hover:scale-[1.02]"
      >
        <MessageCircle class="w-5 h-5 text-emerald-300" />
        <span>Réclamer Mon Mois Gratuit sur WhatsApp</span>
      </a>

      <button
        id="dismiss-exit-popup"
        type="button"
        class="text-xs text-gray-400 hover:text-gray-200 transition-colors py-1.5 focus:outline-none"
      >
        Non merci, je préfère passer à côté de cette offre
      </button>
    </div>

  </div>
</div>

<script>
  const STORAGE_KEY = 'france_iptv_exit_popup_24h_v1';
  const POPUP_COOLDOWN_MS = 24 * 60 * 60 * 1000; // Strictly once per 24 hours per user

  let exitPopupShown = false;
  const popup = document.getElementById('exit-popup');
  const closeBtn = document.getElementById('close-exit-popup');
  const dismissBtn = document.getElementById('dismiss-exit-popup');
  const ctaBtn = document.getElementById('exit-popup-cta');

  function isEligibleToShow(): boolean {
    if (exitPopupShown) return false;
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown) {
      const timePassed = Date.now() - parseInt(lastShown, 10);
      if (timePassed < POPUP_COOLDOWN_MS) {
        return false;
      }
    }
    return true;
  }

  function showPopup() {
    if (!isEligibleToShow()) return;
    if (popup) {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      setTimeout(() => {
        popup.classList.remove('opacity-0');
        const modal = popup.querySelector('div');
        if (modal) modal.classList.remove('scale-95');
      }, 20);
      exitPopupShown = true;
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  function hidePopup() {
    if (popup) {
      popup.classList.add('opacity-0');
      const modal = popup.querySelector('div');
      if (modal) modal.classList.add('scale-95');
      setTimeout(() => {
        popup.classList.remove('flex');
        popup.classList.add('hidden');
      }, 300);
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  // Detect mouse leaving viewport at the top (Desktop exit intent)
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 10) {
      showPopup();
    }
  });

  // Mobile fallback: trigger after 45 seconds of browsing if eligible
  setTimeout(() => {
    showPopup();
  }, 45000);

  if (closeBtn) closeBtn.addEventListener('click', hidePopup);
  if (dismissBtn) dismissBtn.addEventListener('click', hidePopup);
  if (ctaBtn) ctaBtn.addEventListener('click', hidePopup);
</script>
