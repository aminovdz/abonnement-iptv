---
import { Star, Tv, CheckCircle2, ArrowRight, MessageCircle, Signal, Shield, Zap } from 'lucide-astro';

interface Props {
  headline?: string;
  subheadline?: string;
  cityName?: string;
}

const {
  cityName,
  headline,
  subheadline = cityName
    ? `Profitez du meilleur abonnement IPTV à ${cityName} sans antenne parabolique ni box opérateur contraignante. Accédez à un streaming 4K Ultra HD stable avec la technologie Anti-Freeze 9.8™, le sport en direct et une activation en 2 minutes.`
    : "Vous recherchez un service stable et rapide en France ? Notre abonnement IPTV officiel vous fait bénéficier d'une qualité d'image exceptionnelle en 4K et 8K à 60 FPS, sans coupure ni ralentissement lors des grands soirs d'événements sportifs."
} = Astro.props;

const whatsappTrialUrl = "https://wa.me/18036582620?text=Bonjour%21+Je+souhaite+tester+gratuitement+votre+abonnement+IPTV+France+pendant+24h.";
---

<section class="relative pt-8 pb-20 md:pt-16 md:pb-28 overflow-hidden" aria-labelledby="hero-title">
  <!-- Ambient Lighting Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[850px] h-[400px] bg-gradient-to-b from-[#0055D4]/15 via-[#DC2626]/08 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-44 right-10 w-96 h-96 bg-[#0055D4]/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-[#DC2626]/08 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & SEO Keyword Placement -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#11121C] border border-[#0055D4]/40 shadow-[0_0_20px_rgba(0,85,212,0.2)] mb-6">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-xs font-semibold tracking-wide text-gray-200 flex items-center gap-1.5">
            <span class="text-[#60A5FA] font-bold">Fournisseur Officiel en France</span> · Serveurs Dédiés 10 Gbps Anti-Freeze
          </span>
        </div>

        <!-- Single Page H1 Tag with Exact Primary Keyword Placement -->
        <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12] mb-6">
          {headline ? (
            headline
          ) : cityName ? (
            <>
              Abonnement IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">{cityName}</span> — Streaming 4K Sans Coupure
            </>
          ) : (
            <>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-100 to-gray-300">
                Le Meilleur
              </span>{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">
                Abonnement IPTV
              </span>{" "}
              <span class="text-white block sm:inline">
                en France Haute Définition
              </span>
            </>
          )}
        </h1>

        <!-- Primary Keyword within First 75-100 Words -->
        <p class="text-base sm:text-lg md:text-xl text-gray-300 font-normal leading-relaxed mb-8 max-w-2xl">
          {subheadline} En choisissant un <strong>abonnement IPTV</strong> premium, vous bénéficiez d'une diffusion fluide en Ultra Haute Définition 4K et 8K sans payer des centaines d'euros d'abonnements cumulés. Tous vos flux favoris, retransmissions sportives et divertissements sont réunis sur une seule application avec notre technologie Anti-Freeze 9.8™. Assistance technique 7j/7 en français et activation immédiate.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-8 w-full max-w-xl">
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>Streaming 4K/8K 60FPS avec technologie Anti-Freeze</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>Lecteur Premium offert avec les formules 6 & 12 mois</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>Codes d'activation livrés sur WhatsApp en 2 minutes</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>Sans engagement & garantie de remboursement 24h</span>
          </div>
        </div>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-8">
          <a
            href={whatsappTrialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#0055D4] via-[#1E40AF] to-[#0055D4] text-white font-extrabold text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(0,85,212,0.4)] hover:shadow-[0_0_40px_rgba(0,85,212,0.65)] transition-all duration-300 hover:scale-[1.03] active:scale-[0.98]"
            aria-label="Tester l'abonnement IPTV gratuitement pendant 24h sur WhatsApp"
          >
            <MessageCircle class="w-5 h-5 text-emerald-300" />
            <span>Tester 24h Gratuitement</span>
            <ArrowRight class="w-4 h-4 ml-1" />
          </a>

          <a
            href="/#pricing"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-[#11121C] hover:bg-[#171927] text-white font-bold text-sm tracking-wide border border-white/[0.12] hover:border-[#DC2626]/50 transition-all duration-300 hover:scale-[1.02]"
            aria-label="Voir la grille tarifaire complète des abonnements"
          >
            <span>Voir les Formules (dès 8 €)</span>
          </a>
        </div>

        <!-- Social Proof Stats Mini Strip -->
        <div class="flex items-center gap-6 pt-4 border-t border-white/[0.08] w-full max-w-xl">
          <div class="flex items-center gap-1.5">
            <div class="flex text-amber-400">
              {[...Array(5)].map(() => (
                <Star class="w-4 h-4 fill-amber-400 text-amber-400" />
              ))}
            </div>
            <span class="text-xs font-bold text-white ml-1">4.94 / 5</span>
          </div>
          <div class="h-4 w-px bg-white/[0.1]"></div>
          <div class="text-xs text-gray-300">
            <strong class="text-white font-semibold">2 460+</strong> abonnés actifs en France
          </div>
          <div class="h-4 w-px bg-white/[0.1]"></div>
          <div class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 99.9% Uptime
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Glassmorphic Visual Dashboard -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl bg-gradient-to-br from-[#121422] via-[#0D0E18] to-[#08090E] border border-white/[0.1] p-6 sm:p-7 shadow-[0_20px_60px_rgba(0,0,0,0.8)] backdrop-blur-2xl overflow-hidden">
          
          <!-- Top Screen Bar -->
          <div class="flex items-center justify-between pb-5 border-b border-white/[0.08] mb-5">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              <span class="ml-2 text-xs font-mono text-gray-400">france-iptv-server-01.fr</span>
            </div>
            <span class="px-2.5 py-1 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold tracking-wider uppercase flex items-center gap-1">
              <Signal class="w-3 h-3" /> Connecté 10 Gbps
            </span>
          </div>

          <!-- Video Stream Simulation Screen -->
          <div class="relative rounded-2xl bg-gradient-to-br from-[#0B0D18] to-[#04050A] border border-white/[0.08] p-5 mb-5 overflow-hidden">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-wider animate-pulse">
                  DIRECT
                </span>
                <span class="text-xs font-bold text-gray-200">Football & Grands Événements</span>
              </div>
              <span class="text-[11px] font-mono text-gray-400 bg-white/[0.05] px-2 py-0.5 rounded border border-white/[0.06]">
                4K UHD · 60 FPS
              </span>
            </div>

            <!-- Stream Video Preview Image -->
            <div class="rounded-xl overflow-hidden my-3 border border-white/[0.08] shadow-md group">
              <img 
                src="/images/interface-lecteur-iptv.webp" 
                alt="Abonnement IPTV France en streaming direct 4K 60 FPS avec technologie Anti-Freeze 9.8" 
                class="w-full h-36 sm:h-40 object-cover transition-transform duration-700 group-hover:scale-105"
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
            </div>

            <!-- Dashboard Stream Metrics -->
            <div class="grid grid-cols-3 gap-3 text-center my-4">
              <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.04]">
                <div class="text-[10px] text-gray-400 uppercase font-semibold">Latence</div>
                <div class="text-sm font-black text-emerald-400">12 ms</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.04]">
                <div class="text-[10px] text-gray-400 uppercase font-semibold">Anti-Freeze</div>
                <div class="text-sm font-black text-[#60A5FA]">v9.8 Actif</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.04]">
                <div class="text-[10px] text-gray-400 uppercase font-semibold">Buffer</div>
                <div class="text-sm font-black text-emerald-400">0.00 %</div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06] text-xs text-gray-400">
              <span class="flex items-center gap-1.5">
                <Zap class="w-3.5 h-3.5 text-amber-400" /> Flux Fibre Dédié
              </span>
              <span class="text-gray-300 font-medium">Codec HEVC / H.265</span>
            </div>
          </div>

          <!-- Quick Highlight Feature Tags -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.05] transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#0055D4]/20 border border-[#0055D4]/30 flex items-center justify-center text-[#60A5FA]">
                  <Tv class="w-4 h-4" />
                </div>
                <div>
                  <div class="text-xs font-bold text-white">Smart TV & Boîtiers</div>
                  <div class="text-[11px] text-gray-400">Compatible Smart TV connectées, clés 4K & boîtiers</div>
                </div>
              </div>
              <span class="text-[10px] font-bold text-[#10B981] uppercase bg-[#10B981]/10 px-2 py-1 rounded">100% Fluide</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.05] transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#DC2626]/20 border border-[#DC2626]/30 flex items-center justify-center text-red-400">
                  <Shield class="w-4 h-4" />
                </div>
                <div>
                  <div class="text-xs font-bold text-white">Garantie & Support Réactif</div>
                  <div class="text-[11px] text-gray-400">Assistance 24/7 en français & remboursement 24h</div>
                </div>
              </div>
              <span class="text-[10px] font-bold text-gray-300 uppercase bg-white/[0.05] px-2 py-1 rounded">Sans Risque</span>
            </div>
          </div>

          <!-- Bottom Promotion Footnote -->
          <div class="mt-4 pt-3 border-t border-white/[0.06] text-center">
            <p class="text-[11px] text-gray-400">
              ⚡ Démarrez en quelques instants : recevez vos identifiants sécurisés directement sur WhatsApp ou par email.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
