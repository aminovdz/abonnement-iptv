---
import { Star, ShieldCheck, CheckCircle2, Tv, Sparkles, ThumbsUp } from 'lucide-astro';

interface Review {
  name: string;
  city: string;
  rating: number;
  date: string;
  plan: string;
  device: string;
  title: string;
  comment: string;
  verified: boolean;
  source: string;
}

const reviews: Review[] = [
  {
    name: "Alexandre Mercier",
    city: "Marseille",
    rating: 5,
    date: "14 septembre 2026",
    plan: "Formule 12 Mois (55 € + Lecteur Premium)",
    device: "Clé Multimédia TV 4K",
    title: "Zéro coupure pendant les grands soirs de Ligue 1. Le meilleur service testé !",
    comment: "Après la hausse incompréhensible des prix du football en France (abonnements traditionnels à 40 €/mois), j'ai sauté le pas. J'ai pris la formule 12 mois avec le lecteur offert. Franchement impressionné : qualité 4K bluffante, aucun freeze pendant le Classico et activation sur WhatsApp en moins de 2 minutes !",
    verified: true,
    source: "Avis Client Vérifié"
  },
  {
    name: "Julien Delorme",
    city: "Paris",
    rating: 5,
    date: "28 août 2026",
    plan: "Formule 12 Mois (55 € + Lecteur Premium)",
    device: "Smart TV OLED 4K",
    title: "J'économise plus de 80 € par mois par rapport à mes anciens abonnements",
    comment: "Je cumulais les bouquets sportifs payants et les options cinéma pour près de 90 € par mois. Avec cet abonnement à 55 € pour l'année complète, j'ai tout réuni au même endroit sur mon téléviseur. L'EPG et le Replay 7 jours marchent parfaitement, le service client en français est d'une grande réactivité.",
    verified: true,
    source: "Avis Trustpilot Vérifié"
  },
  {
    name: "Stéphane Roche",
    city: "Lyon",
    rating: 5,
    date: "5 septembre 2026",
    plan: "Formule 12 Mois (55 € + Lecteur Premium)",
    device: "Boîtier TV 4K",
    title: "Stabilité irréprochable avec l'Anti-Freeze 9.8™. Très satisfait !",
    comment: "J'avais testé plusieurs fournisseurs bon marché qui plantaient dès 21h le week-end. Ici, la bande passante dédiée tient ses promesses. Le flux reste en 60 FPS fluide même en pleine heure de pointe. Configuration guidée en 3 minutes sur l'application offerte.",
    verified: true,
    source: "Avis Client Vérifié"
  },
  {
    name: "Antoine Lambert",
    city: "Toulouse",
    rating: 5,
    date: "2 septembre 2026",
    plan: "Formule 6 Mois (30 €)",
    device: "Smart TV Connectée",
    title: "Top 14 de Rugby et sport européen en direct avec une netteté incroyable",
    comment: "Passionné de rugby, je peux suivre tous les matchs du Stade Toulousain et les championnats européens en très haute définition. Paiement sécurisé par carte, identifiants reçus immédiatement. Je renouvellerai sans hésiter pour 12 mois.",
    verified: true,
    source: "Avis Vérifié"
  },
  {
    name: "Maxime Faure",
    city: "Lille",
    rating: 5,
    date: "20 août 2026",
    plan: "Formule 12 Mois (55 €)",
    device: "Boîtier Android TV 4K",
    title: "L'application Lecteur Premium offerte transforme complètement l'expérience",
    comment: "L'application fournie gratuitement avec le forfait annuel est super ergonomique, avec zapping instantané en moins d'une seconde et favoris bien classés. Mes enfants adorent les documentaires et les dessins animés. Excellent rapport qualité/prix.",
    verified: true,
    source: "Avis Client Vérifié"
  },
  {
    name: "Thibault Garnier",
    city: "Bordeaux",
    rating: 5,
    date: "10 septembre 2026",
    plan: "Formule 3 Mois (20 €)",
    device: "Clé Multimédia 4K",
    title: "Support client au top sur WhatsApp, ils m'ont aidé en soirée",
    comment: "N'étant pas très à l'aise avec la technique, j'ai envoyé un message sur leur WhatsApp. Un technicien m'a envoyé des captures d'écran et en 5 minutes tout fonctionnait sur ma télé de salon. Bravo pour le professionnalisme.",
    verified: true,
    source: "Avis Vérifié"
  }
];
---

<section id="reviews" class="py-20 md:py-28 relative bg-[#090A10] overflow-hidden" aria-labelledby="reviews-heading">
  <!-- Ambient Gradients -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/3 right-10 w-[600px] h-[350px] bg-[#0055D4]/08 rounded-full blur-[150px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Retours d'Expérience Réels</span>
      </div>
      <h2 id="reviews-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        Ce Que Disent Nos Abonnés en <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">France</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed">
        Découvrez les témoignages authentiques de clients qui utilisent quotidiennement notre abonnement IPTV sur leur Smart TV connectée, clé multimédia TV 4K et boîtiers.
      </p>

      <!-- Rating Summary Card -->
      <div class="mt-8 inline-flex flex-wrap items-center justify-center gap-4 sm:gap-8 px-6 py-4 rounded-2xl bg-[#11121C] border border-white/[0.08] shadow-lg">
        <div class="flex items-center gap-2">
          <div class="flex text-amber-400">
            {[...Array(5)].map(() => (
              <Star class="w-5 h-5 fill-amber-400 text-amber-400" />
            ))}
          </div>
          <span class="text-xl font-black text-white">4.94 / 5</span>
        </div>
        <div class="hidden sm:block h-6 w-px bg-white/[0.1]"></div>
        <div class="text-xs text-gray-300">
          Basé sur <strong class="text-white font-bold">2 460+ avis vérifiés</strong> en France
        </div>
        <div class="hidden sm:block h-6 w-px bg-white/[0.1]"></div>
        <div class="flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
          <ShieldCheck class="w-4 h-4" />
          <span>Garantie Remboursement 24h</span>
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="rounded-3xl bg-[#11121C]/90 border border-white/[0.08] hover:border-[#0055D4]/40 p-7 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-md">
          <div>
            <!-- Star Rating & Date -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-amber-400">
                {[...Array(rev.rating)].map(() => (
                  <Star class="w-4 h-4 fill-amber-400 text-amber-400" />
                ))}
              </div>
              <span class="text-[11px] text-gray-400 font-mono">
                {rev.date}
              </span>
            </div>

            <!-- Review Title -->
            <h3 class="text-base font-bold text-white mb-3 tracking-tight leading-snug">
              « {rev.title} »
            </h3>

            <!-- Comment -->
            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal mb-6">
              {rev.comment}
            </p>
          </div>

          <!-- Author Info & Meta -->
          <div class="pt-4 border-t border-white/[0.06]">
            <div class="flex items-center justify-between mb-2">
              <div>
                <div class="text-sm font-bold text-white flex items-center gap-1.5">
                  <span>{rev.name}</span>
                  <CheckCircle2 class="w-3.5 h-3.5 text-emerald-400" />
                </div>
                <div class="text-[11px] text-gray-400">
                  {rev.city}, France
                </div>
              </div>

              <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                {rev.source}
              </span>
            </div>

            <!-- Plan & Device Tag -->
            <div class="flex items-center justify-between text-[11px] text-gray-400 pt-2 border-t border-white/[0.04]">
              <span class="text-[#60A5FA] font-medium">{rev.plan}</span>
              <span class="flex items-center gap-1">
                <Tv class="w-3 h-3 text-gray-400" /> {rev.device}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Review CTA Strip -->
    <div class="mt-14 text-center">
      <p class="text-xs text-gray-400 mb-4">
        Vous êtes déjà abonné ? Partagez votre expérience avec notre communauté.
      </p>
      <a
        href="https://wa.me/18036582620?text=Bonjour%21+Je+souhaite+laisser+un+avis+sur+mon+abonnement+IPTV."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-white text-xs font-bold uppercase tracking-wider transition-colors"
      >
        <ThumbsUp class="w-3.5 h-3.5 text-amber-400" />
        <span>Déposer un Avis Client</span>
      </a>
    </div>

  </div>
</section>
