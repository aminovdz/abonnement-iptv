---
import { Zap, Calendar, PlayCircle, Radio, RefreshCw, ChevronLeft, ChevronRight, ArrowRight } from 'lucide-astro';

interface LiveMatch {
  id: string;
  league: string;
  sport: string;
  homeTeam: string;
  homeLogo: string;
  homeScore: string;
  awayTeam: string;
  awayLogo: string;
  awayScore: string;
  status: string;
  isLive: boolean;
  quality: string;
}

// Fallback real fixtures in case ESPN API is unreachable at build time
const fallbackMatches: LiveMatch[] = [
  {
    id: "401876449",
    league: "Ligue 1 France",
    sport: "Football",
    homeTeam: "Marseille",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/176.png",
    homeScore: "1",
    awayTeam: "Paris Saint-Germain",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/160.png",
    awayScore: "2",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "401876452",
    league: "Ligue 1 France",
    sport: "Football",
    homeTeam: "Nice",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/2502.png",
    homeScore: "2",
    awayTeam: "Lille",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/166.png",
    awayScore: "1",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "401876456",
    league: "Ligue 1 France",
    sport: "Football",
    homeTeam: "AJ Auxerre",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/172.png",
    homeScore: "2",
    awayTeam: "Brest",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/6997.png",
    awayScore: "1",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "ucl-1",
    league: "UEFA Champions League",
    sport: "Football",
    homeTeam: "Real Madrid",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/86.png",
    homeScore: "3",
    awayTeam: "Manchester City",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/382.png",
    awayScore: "2",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "ucl-2",
    league: "UEFA Champions League",
    sport: "Football",
    homeTeam: "Bayern Munich",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/132.png",
    homeScore: "5",
    awayTeam: "Bodo/Glimt",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/4094.png",
    awayScore: "0",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "ucl-3",
    league: "UEFA Champions League",
    sport: "Football",
    homeTeam: "Sporting CP",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/499.png",
    homeScore: "2",
    awayTeam: "Lens",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/165.png",
    awayScore: "1",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "epl-1",
    league: "Premier League Anglaise",
    sport: "Football",
    homeTeam: "Liverpool",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/364.png",
    homeScore: "3",
    awayTeam: "AFC Bournemouth",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/349.png",
    awayScore: "0",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  },
  {
    id: "epl-2",
    league: "Premier League Anglaise",
    sport: "Football",
    homeTeam: "Arsenal",
    homeLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/359.png",
    homeScore: "2",
    awayTeam: "Chelsea",
    awayLogo: "https://a.espncdn.com/i/teamlogos/soccer/500/363.png",
    awayScore: "2",
    status: "Score Final (FT)",
    isLive: false,
    quality: "4K UHD · 60 FPS"
  }
];

let featuredMatches: LiveMatch[] = fallbackMatches;

try {
  const [resL1, resUCL, resEPL] = await Promise.allSettled([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/fra.1/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json()),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json()),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", { signal: AbortSignal.timeout(3500) }).then(r => r.json())
  ]);

  const parseEvents = (data: any, leagueName: string): LiveMatch[] => {
    if (!data?.events || !Array.isArray(data.events)) return [];
    return data.events.map((event: any) => {
      const comp = event.competitions?.[0];
      const home = comp?.competitors?.find((c: any) => c.homeAway === "home");
      const away = comp?.competitors?.find((c: any) => c.homeAway === "away");
      const isLive = event.status?.type?.state === "in";
      const isPost = event.status?.type?.state === "post";
      let statusText = event.status?.type?.detail || "À venir";
      if (isLive) {
        statusText = `${event.status?.displayClock || ''} En Direct`.trim();
      } else if (isPost) {
        statusText = `Score Final (${event.status?.type?.shortDetail || 'FT'})`;
      }
      return {
        id: String(event.id),
        league: leagueName,
        sport: "Football",
        homeTeam: home?.team?.displayName || home?.team?.name || "Équipe Domicile",
        homeLogo: home?.team?.logo || "https://a.espncdn.com/i/teamlogos/soccer/500/default-team-logo-500.png",
        homeScore: home?.score || "0",
        awayTeam: away?.team?.displayName || away?.team?.name || "Équipe Extérieure",
        awayLogo: away?.team?.logo || "https://a.espncdn.com/i/teamlogos/soccer/500/default-team-logo-500.png",
        awayScore: away?.score || "0",
        status: statusText,
        isLive,
        quality: "4K UHD · 60 FPS"
      };
    });
  };

  const l1Matches = resL1.status === "fulfilled" ? parseEvents(resL1.value, "Ligue 1 France") : [];
  const uclMatches = resUCL.status === "fulfilled" ? parseEvents(resUCL.value, "UEFA Champions League") : [];
  const eplMatches = resEPL.status === "fulfilled" ? parseEvents(resEPL.value, "Premier League Anglaise") : [];
  
  const realMatches = [...l1Matches, ...uclMatches, ...eplMatches];

  if (realMatches.length >= 4) {
    featuredMatches = realMatches;
  }
} catch {
  featuredMatches = fallbackMatches;
}

// Seamless duplication for infinite loop carousel
const carouselItems = [...featuredMatches, ...featuredMatches];
---

<section id="live-scores" class="py-14 md:py-20 relative bg-[#0C0D16] overflow-hidden border-b border-white/[0.06]" aria-labelledby="livescores-heading">
  <!-- Ambient Gradients -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/3 w-[600px] h-[300px] bg-[#0055D4]/10 rounded-full blur-[160px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clickable & pointing to /livescore/) -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <a 
        href="/livescore/" 
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#DC2626]/15 hover:bg-[#DC2626]/25 border border-[#DC2626]/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4 transition-all duration-200 hover:scale-105 group"
        title="Accéder au Match Center en Direct"
      >
        <Radio class="w-3.5 h-3.5 animate-pulse" />
        <span>Scores & Matchs Officiels en Direct</span>
        <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
      </a>

      <h2 id="livescores-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        <a href="/livescore/" class="hover:text-[#60A5FA] transition-colors" title="Ouvrir le Match Center">
          Tous Vos Matchs en Direct en <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">4K & 60 FPS</span>
        </a>
      </h2>

      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed">
        Suivez chaque rencontre de Ligue 1 et des coupes européennes en temps réel. <a href="/livescore/" class="text-[#60A5FA] font-bold hover:underline">Cliquez sur un match</a> pour ouvrir notre Match Center complet.
      </p>
    </div>

    <!-- Live Sync Status Bar with Match Center Direct Link -->
    <div class="max-w-7xl mx-auto mb-8 flex flex-wrap items-center justify-between gap-4 px-5 py-3 rounded-2xl bg-[#11121C] border border-white/[0.08] text-xs text-gray-300">
      <div class="flex items-center gap-2.5">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-medium text-gray-200">Flux officiel synchronisé avec l'API Sport 4K</span>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center gap-2 text-gray-400">
          <RefreshCw class="w-3.5 h-3.5 text-[#60A5FA] animate-spin" style="animation-duration: 8s;" />
          <span id="live-refresh-time">Actualisation automatique (Ligue 1 & Coupes)</span>
        </div>

        <a 
          href="/livescore/"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[#0055D4]/20 hover:bg-[#0055D4]/35 text-[#60A5FA] font-bold text-xs border border-[#0055D4]/30 transition-colors"
        >
          <span>Match Center</span>
          <ArrowRight class="w-3 h-3" />
        </a>
      </div>
    </div>

    <!-- Infinite Loop Carousel Wrapper -->
    <div class="relative w-full overflow-hidden py-4 -my-4 group/carousel" id="livescores-carousel-container">
      
      <!-- Gradient Edge Masks (Luxury Cinematic Fade) -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-12 sm:w-28 bg-gradient-to-r from-[#0C0D16] to-transparent z-20"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-12 sm:w-28 bg-gradient-to-l from-[#0C0D16] to-transparent z-20"></div>

      <!-- Carousel Navigation Arrows (Desktop overlay) -->
      <button 
        id="carousel-prev-btn" 
        class="absolute left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 hover:bg-[#0055D4] transition-all duration-300 shadow-xl"
        aria-label="Match précédent"
      >
        <ChevronLeft class="w-5 h-5" />
      </button>

      <button 
        id="carousel-next-btn" 
        class="absolute right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 hover:bg-[#0055D4] transition-all duration-300 shadow-xl"
        aria-label="Match suivant"
      >
        <ChevronRight class="w-5 h-5" />
      </button>

      <!-- Infinite Sliding Track -->
      <div 
        id="infinite-track" 
        class="flex gap-5 will-change-transform" 
        style="width: max-content;"
      >
        {carouselItems.map((match) => (
          <a
            href={`/livescore?match=${match.id}`}
            class="fixture-card shrink-0 w-[310px] sm:w-[350px] rounded-3xl bg-[#121422] border border-white/[0.08] hover:border-[#0055D4]/60 p-5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_10px_35px_rgba(0,85,212,0.3)] group cursor-pointer"
            data-match-card={match.id}
            title={`Ouvrir le Match Center : ${match.homeTeam} vs ${match.awayTeam}`}
          >
            <div>
              <!-- Header: League & Status Badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-[#60A5FA] flex items-center gap-1.5 truncate max-w-[190px]">
                  <Calendar class="w-3.5 h-3.5 shrink-0" />
                  <span class="truncate">{match.league}</span>
                </span>

                {match.isLive ? (
                  <span class="match-status-badge shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-500/20 border border-red-500/40 text-red-400 text-[10px] font-black uppercase tracking-wider animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                    <span class="status-text">{match.status}</span>
                  </span>
                ) : (
                  <span class="match-status-badge shrink-0 text-[10px] font-bold text-gray-300 bg-white/[0.05] px-2.5 py-1 rounded-full border border-white/[0.06]">
                    <span class="status-text">{match.status}</span>
                  </span>
                )}
              </div>

              <!-- Scoreboard -->
              <div class="space-y-3.5 my-3 bg-[#090A12]/80 p-3.5 rounded-2xl border border-white/[0.04]">
                <!-- Home Team -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <img 
                      src={match.homeLogo} 
                      alt={`Logo club ${match.homeTeam}`} 
                      class="w-6 h-6 object-contain rounded-full bg-white/5 p-0.5"
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span class="text-sm font-bold text-white group-hover:text-[#60A5FA] transition-colors home-team-name truncate max-w-[160px]">
                      {match.homeTeam}
                    </span>
                  </div>
                  <span class="text-lg font-black text-white font-mono px-3 py-0.5 rounded-lg bg-black/60 border border-white/10 home-score">
                    {match.homeScore}
                  </span>
                </div>

                <!-- Away Team -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <img 
                      src={match.awayLogo} 
                      alt={`Logo club ${match.awayTeam}`} 
                      class="w-6 h-6 object-contain rounded-full bg-white/5 p-0.5"
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                    <span class="text-sm font-bold text-white group-hover:text-[#60A5FA] transition-colors away-team-name truncate max-w-[160px]">
                      {match.awayTeam}
                    </span>
                  </div>
                  <span class="text-lg font-black text-white font-mono px-3 py-0.5 rounded-lg bg-black/60 border border-white/10 away-score">
                    {match.awayScore}
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Footer: Quality & Match Center Redirection Indicator -->
            <div class="pt-3.5 border-t border-white/[0.06] flex items-center justify-between mt-2">
              <span class="text-[11px] font-semibold text-emerald-400 flex items-center gap-1">
                <Zap class="w-3 h-3" /> {match.quality}
              </span>

              <span class="inline-flex items-center gap-1 text-xs font-bold text-[#60A5FA] group-hover:text-white group-hover:translate-x-0.5 transition-all">
                <span>Match Center</span>
                <PlayCircle class="w-4 h-4 text-[#0055D4] group-hover:text-[#60A5FA]" />
              </span>
            </div>

          </a>
        ))}
      </div>
    </div>

    <!-- Sports Reassurance Strip with Match Center Action -->
    <div class="mt-12 p-6 rounded-2xl bg-[#11121C] border border-[#0055D4]/25 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <h3 class="text-sm font-bold text-white mb-1">
          Tous les championnats français et européens en direct
        </h3>
        <p class="text-xs text-gray-300">
          Ligue 1, Champions League, Premier League, Top 14 de Rugby & F1 inclus avec la technologie Anti-Freeze 9.8™.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/livescore/"
          class="inline-flex items-center gap-1.5 px-5 py-3 rounded-xl bg-gradient-to-r from-[#0055D4] to-[#2563EB] hover:from-[#2563EB] hover:to-[#1D4ED8] text-white text-xs font-bold uppercase tracking-wider shadow-md transition-all"
        >
          <span>Match Center (Scores & Direct)</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Scoped Infinite Loop Animation Styles -->
<style>
  @keyframes infinite-loop-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  #infinite-track {
    animation: infinite-loop-slide 45s linear infinite;
  }

  #livescores-carousel-container:hover #infinite-track {
    animation-play-state: paused;
  }
</style>

<!-- Client Script for Seamless Infinite Loop Carousel Interaction & Live Sync -->
<script is:inline>
  (function initLiveScoresCarousel() {
    const track = document.getElementById('infinite-track');
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    // Manual navigation buttons handling
    if (prevBtn && nextBtn && track) {
      let manualOffset = 0;
      const step = 340; // card width + gap

      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        track.style.animation = 'none';
        manualOffset += step;
        if (manualOffset > 0) manualOffset = -track.scrollWidth / 2;
        track.style.transform = `translateX(${manualOffset}px)`;
        track.style.transition = 'transform 0.4s ease-out';
      });

      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        track.style.animation = 'none';
        manualOffset -= step;
        if (Math.abs(manualOffset) >= track.scrollWidth / 2) manualOffset = 0;
        track.style.transform = `translateX(${manualOffset}px)`;
        track.style.transition = 'transform 0.4s ease-out';
      });
    }

    // Real-time live score updates
    async function updateScores() {
      try {
        const [resL1, resUCL, resEPL] = await Promise.allSettled([
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/fra.1/scoreboard').then(r => r.json()),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard').then(r => r.json()),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard').then(r => r.json())
        ]);

        const allEvents = [];
        if (resL1.status === 'fulfilled' && resL1.value?.events) allEvents.push(...resL1.value.events);
        if (resUCL.status === 'fulfilled' && resUCL.value?.events) allEvents.push(...resUCL.value.events);
        if (resEPL.status === 'fulfilled' && resEPL.value?.events) allEvents.push(...resEPL.value.events);

        allEvents.forEach(event => {
          const comp = event.competitions?.[0];
          const home = comp?.competitors?.find(c => c.homeAway === 'home');
          const away = comp?.competitors?.find(c => c.homeAway === 'away');
          if (!home || !away) return;

          const cards = document.querySelectorAll(`[data-match-card="${event.id}"]`);
          cards.forEach(card => {
            const homeScoreEl = card.querySelector('.home-score');
            const awayScoreEl = card.querySelector('.away-score');
            const statusTextEl = card.querySelector('.status-text');

            if (homeScoreEl) homeScoreEl.textContent = home.score || '0';
            if (awayScoreEl) awayScoreEl.textContent = away.score || '0';

            if (statusTextEl) {
              const isLive = event.status?.type?.state === 'in';
              const isPost = event.status?.type?.state === 'post';
              if (isLive) {
                statusTextEl.textContent = `${event.status?.displayClock || ''} En Direct`.trim();
              } else if (isPost) {
                statusTextEl.textContent = `Score Final (${event.status?.type?.shortDetail || 'FT'})`;
              } else {
                statusTextEl.textContent = event.status?.type?.detail || 'À venir';
              }
            }
          });
        });

        const refreshTimeEl = document.getElementById('live-refresh-time');
        if (refreshTimeEl) {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          refreshTimeEl.textContent = `Actualisé à ${timeStr} (En direct)`;
        }
      } catch (err) {
        // Silently preserve current display on network hiccup
      }
    }

    // Refresh every 30 seconds
    setInterval(updateScores, 30000);
  })();
</script>
