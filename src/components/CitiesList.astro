---
import { MapPin, ArrowRight, Signal } from 'lucide-astro';

const cities = [
  {
    name: "Paris",
    slug: "paris",
    region: "Île-de-France",
    description: "Interconnexion directe aux points d'échange TH2 et Equinix Paris. Latence ultra-basse < 10ms et fluidité 4K garantie.",
    highlight: "Hub Fibre & 5G"
  },
  {
    name: "Marseille",
    slug: "marseille",
    region: "Provence-Alpes-Côte d'Azur",
    description: "Routage optimisé via les datacenters marseillais Interxion. Streaming parfait pour les soirs de match de l'OM.",
    highlight: "Serveurs Méditerranée"
  },
  {
    name: "Lyon",
    slug: "lyon",
    region: "Auvergne-Rhône-Alpes",
    description: "Accès haute vitesse via le nœud LyonIX. Bande passante stable et sans bridage opérateur lors des grands directs.",
    highlight: "Nœud LyonIX"
  },
  {
    name: "Toulouse",
    slug: "toulouse",
    region: "Occitanie",
    description: "Idéal pour le streaming 4K du Top 14 de rugby et du football. Connexion instantanée sur Smart TV et boîtiers TV.",
    highlight: "Top 14 & Sport"
  },
  {
    name: "Nice",
    slug: "nice",
    region: "Provence-Alpes-Côte d'Azur",
    description: "Excellente couverture fibre et mobile pour les résidents de la Côte d'Azur. Technologie Anti-Freeze 9.8™ active.",
    highlight: "Côte d'Azur HD"
  },
  {
    name: "Nantes",
    slug: "nantes",
    region: "Pays de la Loire",
    description: "Routage rapide sur l'ouest de la France. Replay 7 jours et haute définition 60 FPS sans coupure.",
    highlight: "Ouest Fibre"
  },
  {
    name: "Strasbourg",
    slug: "strasbourg",
    region: "Grand Est",
    description: "Proximité immédiate des dorsales européennes pour un ping ultra-stable en Alsace et dans le Grand Est.",
    highlight: "Euro-Routage"
  },
  {
    name: "Montpellier",
    slug: "montpellier",
    region: "Occitanie",
    description: "Serveurs dédiés pour la région méditerranéenne. Activation immédiate en 2 minutes via WhatsApp.",
    highlight: "Activation Express"
  },
  {
    name: "Bordeaux",
    slug: "bordeaux",
    region: "Nouvelle-Aquitaine",
    description: "Réseau optimisé pour le Sud-Ouest. Regardez vos compétitions préférées en Ultra HD sans antenne.",
    highlight: "Aquitaine 4K"
  },
  {
    name: "Lille",
    slug: "lille",
    region: "Hauts-de-France",
    description: "Liaisons directes avec le nord de la France et la dorsale francophone. Zéro ralentissement en soirée.",
    highlight: "Hauts-de-France"
  }
];
---

<section id="cities-list" class="py-20 md:py-28 relative bg-[#0C0D16] overflow-hidden" aria-labelledby="cities-heading">
  <!-- Ambient Glow -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute bottom-0 right-1/4 w-[600px] h-[300px] bg-[#0055D4]/08 rounded-full blur-[150px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0055D4]/15 border border-[#0055D4]/30 text-[#60A5FA] text-xs font-bold uppercase tracking-wider mb-4">
        <MapPin class="w-3.5 h-3.5 text-[#DC2626]" />
        <span>Réseau France Haute Performance</span>
      </div>
      <h2 id="cities-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        Abonnement IPTV Disponible dans <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#FFFFFF] to-[#F87171]">Toute la France</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed">
        Grâce à nos serveurs de cache CDN déployés au plus près des métropoles régionales françaises, profitez d'une latence minimale et d'une fluidité parfaite chez vous.
      </p>
    </div>

    <!-- Cities Grid (10 Cities) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      {cities.map((city) => (
        <a
          href={`/locations/${city.slug}`}
          class="group rounded-2xl bg-[#121422] hover:bg-[#161828] border border-white/[0.08] hover:border-[#0055D4]/50 p-5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 shadow-md"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-gray-400 group-hover:text-white transition-colors flex items-center gap-1.5">
                <MapPin class="w-3.5 h-3.5 text-[#DC2626]" /> {city.region}
              </span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-[#0055D4]/15 text-[#60A5FA] border border-[#0055D4]/25">
                {city.highlight}
              </span>
            </div>

            <h3 class="text-lg font-black text-white mb-2 group-hover:text-[#60A5FA] transition-colors flex items-center justify-between">
              <span>{city.name}</span>
              <ArrowRight class="w-4 h-4 opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all text-[#60A5FA]" />
            </h3>

            <p class="text-xs text-gray-300 leading-relaxed font-normal">
              {city.description}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between text-[11px] text-gray-400">
            <span class="flex items-center gap-1 text-emerald-400">
              <Signal class="w-3 h-3" /> Latence &lt; 15ms
            </span>
            <span class="text-gray-300 font-semibold group-hover:underline">Découvrir ›</span>
          </div>
        </a>
      ))}
    </div>

    <!-- National Coverage Reassurance -->
    <div class="mt-12 text-center text-xs text-gray-400 flex flex-wrap items-center justify-center gap-6">
      <span>✓ Fonctionne avec toutes les box internet (Orange, Free, SFR, Bouygues Telecom)</span>
      <span>•</span>
      <span>✓ Compatible connexions Fibre, ADSL, 4G et 5G</span>
      <span>•</span>
      <span>✓ DROM-COM & Français à l'étranger inclus</span>
    </div>

  </div>
</section>
