---
import { X } from 'lucide-astro';

interface Props {
  phoneNumber?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = '18036582620',
  defaultMessage = "Bonjour ! Je souhaite obtenir des informations sur l'abonnement IPTV et tester le service."
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="fixed bottom-5 right-5 z-40 flex flex-col items-end">
  <!-- Interactive Prompt Tooltip -->
  <div
    id="whatsapp-tooltip"
    class="mb-3 max-w-xs p-3.5 rounded-2xl bg-[#11121C] border border-[#0055D4]/40 shadow-2xl text-left relative transform transition-all duration-300 opacity-0 translate-y-2 pointer-events-none"
  >
    <button
      id="close-whatsapp-tooltip"
      type="button"
      class="absolute top-2 right-2 text-gray-400 hover:text-white p-1 rounded-full focus:outline-none"
      aria-label="Fermer la bulle d'aide"
    >
      <X class="w-3.5 h-3.5" />
    </button>
    <div class="flex items-center gap-2 mb-1">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-xs font-bold text-white">Support Technique en Ligne</span>
    </div>
    <p class="text-xs text-gray-300 leading-snug">
      Une question sur l'installation ou nos formules ? Écrivez-nous sur WhatsApp, réponse garantie en moins de 2 minutes !
    </p>
    <!-- Tooltip Arrow -->
    <div class="absolute -bottom-1.5 right-6 w-3 h-3 bg-[#11121C] border-r border-b border-[#0055D4]/40 transform rotate-45"></div>
  </div>

  <!-- Main Floating Action Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactez notre assistance en direct sur WhatsApp"
    class="relative group flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-xl shadow-[#25D366]/35 transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
  >
    <!-- Pulse ring -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-70 animate-ping pointer-events-none group-hover:opacity-0"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-7 h-7 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>

    <!-- Notification badge -->
    <span class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-[#0055D4] text-[10px] font-extrabold text-white border-2 border-[#090A10] shadow">
      1
    </span>
  </a>
</div>

<script>
  const tooltip = document.getElementById('whatsapp-tooltip');
  const closeBtn = document.getElementById('close-whatsapp-tooltip');

  // Show prompt after 5 seconds
  setTimeout(() => {
    if (tooltip) {
      tooltip.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      tooltip.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }
  }, 5000);

  if (closeBtn && tooltip) {
    closeBtn.addEventListener('click', () => {
      tooltip.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      tooltip.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
    });
  }
</script>
